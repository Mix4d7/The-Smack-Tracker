let parsedRows=[];
document.getElementById('fileInput').addEventListener('change',e=>{if(e.target.files[0])processImage(e.target.files[0]);});
const dz=document.getElementById('dropZone');
dz.addEventListener('dragover',e=>{e.preventDefault();dz.classList.add('drag');});
dz.addEventListener('dragleave',()=>dz.classList.remove('drag'));
dz.addEventListener('drop',e=>{e.preventDefault();dz.classList.remove('drag');if(e.dataTransfer.files[0])processImage(e.dataTransfer.files[0]);});
function setImportStatus(msg,type){const el=document.getElementById('importStatus');el.textContent=msg;el.className='status-bar '+type;el.style.display='block';}
async function processImage(file){
  setImportStatus('reading image...','loading');
  const preview=document.getElementById('previewImg');preview.style.display='block';
  const reader=new FileReader();
  reader.onload=async e=>{
    preview.src=e.target.result;
    const b64=e.target.result.split(',')[1],mime=file.type||'image/jpeg';
    setImportStatus('sending to Claude for handwriting recognition...','loading');
    try{
      const resp=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:1000,messages:[{role:'user',content:[{type:'image',source:{type:'base64',media_type:mime,data:b64}},{type:'text',text:'Photo of handwritten medication notes with columns DATE, TIME, DOSE. Extract every row. Return ONLY a JSON array, no preamble or markdown. Each object: {"time":"2026-06-05T14:30","amountMcg":250,"notes":"","error":null}. If dose is in mg multiply by 1000. Mark illegible rows with error string.'}]}]})});
      const data=await resp.json();
      if(!resp.ok)throw new Error(data.error?.message||'API error');
      const raw=data.content.find(b=>b.type==='text')?.text||'[]';
      parsedRows=JSON.parse(raw.replace(/```json|```/g,'').trim()).map(r=>({time:r.time||'',amountMcg:parseInt(r.amountMcg)||0,drug:'bup',form:'Sublingual film',notes:r.notes||'',symptoms:null,error:r.error||null}));
      setImportStatus('found '+parsedRows.length+' row'+(parsedRows.length!==1?'s':'')+' — review before merging','ok');
      document.getElementById('results-section').style.display='block';renderParsedTable();
    }catch(err){setImportStatus('error: '+err.message,'error');}
  };
  reader.readAsDataURL(file);
}
function renderParsedTable(){
  const ex=loadData(),tbody=document.getElementById('parsedBody');tbody.innerHTML='';
  let cN=0,cD=0,cE=0;
  parsedRows.forEach((row,i)=>{
    const dup=!row.error&&isDup(row,ex);
    const stat=row.error?'error':dup?'duplicate':'new';
    const bc=row.error?'badge-err':dup?'badge-dup':'badge-new';
    if(!row.error&&!dup)cN++;else if(!row.error)cD++;else cE++;
    const dp=row.time?row.time.split('T')[0]:'',tp=row.time?row.time.split('T')[1]:'';
    const tr=document.createElement('tr');
    tr.innerHTML=`<td><input class="edit-cell" data-i="${i}" data-f="date" value="${dp}"></td><td><input class="edit-cell" data-i="${i}" data-f="time" value="${tp}"></td><td><input class="edit-cell" data-i="${i}" data-f="amountMcg" value="${row.amountMcg||''}"></td><td><input class="edit-cell" data-i="${i}" data-f="notes" value="${row.notes||''}"></td><td><span class="row-badge ${bc}">${stat}</span></td>`;
    tbody.appendChild(tr);
  });
  document.getElementById('cnt-total').textContent=parsedRows.length;
  document.getElementById('cnt-new').textContent=cN;
  document.getElementById('cnt-dup').textContent=cD;
  document.getElementById('cnt-err').textContent=cE;
  tbody.querySelectorAll('.edit-cell').forEach(inp=>{
    inp.addEventListener('change',e=>{
      const i=parseInt(e.target.dataset.i),f=e.target.dataset.f;
      if(f==='date'||f==='time'){const d=tbody.querySelector(`[data-i="${i}"][data-f="date"]`).value,t=tbody.querySelector(`[data-i="${i}"][data-f="time"]`).value;parsedRows[i].time=d+'T'+t;}
      else if(f==='amountMcg')parsedRows[i].amountMcg=parseInt(e.target.value)||0;
      else parsedRows[i][f]=e.target.value;
      renderParsedTable();
    });
  });
}
function mergeImport(){
  const ex=loadData(),toAdd=parsedRows.filter(r=>!r.error&&!isDup(r,ex));
  const merged=[...ex,...toAdd].sort((a,b)=>new Date(b.time)-new Date(a.time));
  saveData(merged);
  const mr=document.getElementById('mergeResult');
  mr.style.display='block';mr.className='status-bar ok';
  mr.innerHTML='merged '+toAdd.length+' new entr'+(toAdd.length!==1?'ies':'y')+'. <a href="#" onclick="exportData();return false;" style="color:var(--accent)">download updated json</a>';
}
function resetImport(){
  parsedRows=[];
  document.getElementById('previewImg').style.display='none';
  document.getElementById('importStatus').style.display='none';
  document.getElementById('results-section').style.display='none';
  document.getElementById('mergeResult').style.display='none';
  document.getElementById('fileInput').value='';
  document.getElementById('parsedBody').innerHTML='';
}

