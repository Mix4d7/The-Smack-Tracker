// ─── symptom score UI ─────────────────────────────────────────────────────────
let cravScore = 5, effectScore = 5, sympOpen = false;

function scoreColor(val, type) {
  // cravings: 1=green(ok), 10=red(bad)
  // effect: 1=red(too little), 5-6=green(ok), 10=red(too much)
  if (type === 'crav') {
    const r = Math.round((val - 1) / 9 * 200);
    const g = Math.round((10 - val) / 9 * 160 + 60);
    return `rgb(${r},${g},40)`;
  } else {
    // effect: center (5) is green, extremes are red
    const dist = Math.abs(val - 5.5);
    const r = Math.round(dist / 4.5 * 200 + 20);
    const g = Math.round((4.5 - dist) / 4.5 * 160 + 40);
    return `rgb(${r},${g},40)`;
  }
}

function buildScoreBtns() {
  ['crav','effect'].forEach(type => {
    const el = document.getElementById(type+'Btns');
    if (!el) return;
    el.innerHTML = '';
    for (let i = 1; i <= 10; i++) {
      const btn = document.createElement('button');
      btn.className = 'score-btn' + (i === (type==='crav'?cravScore:effectScore) ? ' active' : '');
      btn.textContent = i;
      const col = scoreColor(i, type);
      if (i === (type==='crav'?cravScore:effectScore)) btn.style.background = col;
      btn.onclick = () => {
        if (type==='crav') { cravScore=i; document.getElementById('cravVal').textContent=i; }
        else { effectScore=i; document.getElementById('effectVal').textContent=i; }
        buildScoreBtns();
      };
      el.appendChild(btn);
    }
  });
}

function toggleSympPanel() {
  sympOpen = !sympOpen;
  document.getElementById('sympPanel').style.display = sympOpen ? 'block' : 'none';
  document.getElementById('sympToggleBtn').textContent = sympOpen ? '− hide cravings / effect' : '+ add cravings / effect';
  if (sympOpen) buildScoreBtns();
}

// ─── prescription-remaining tracker (v2.1) ──────────────────────────────────
// A running balance of buprenorphine left in the current prescription. Logging
// a dose subtracts that dose's mcg from the balance. The number is editable at
// any time behind an "are you sure?" confirm. Stored in mcg (like every dose),
// displayed in the app's current unit. Purely a count the user maintains — it
// does not touch the PK model, occupancy, or the dose log.
const RX_KEY = 'st_rx_remaining_mcg';

function rxGet(){
  try{
    const v = localStorage.getItem(RX_KEY);
    if(v === null || v === '') return null;   // never set
    const n = parseFloat(v);
    return isNaN(n) ? null : n;
  }catch(e){ return null; }
}
function rxSet(mcg){
  try{ localStorage.setItem(RX_KEY, String(mcg)); }catch(e){}
  renderRxRemaining();
}

// Average daily intake (mcg/day) over the last N calendar days that have doses.
// Returns { avg, daysCounted, firstDay, lastDay } or null if no doses in window.
function rxRecentDailyAvg(windowDays){
  const data = getData();                 // newest-first
  if(!data.length) return null;
  // Anchor the window on the most recent dose, not "now" — a gap since the last
  // dose shouldn't deflate the running rate.
  const newest = new Date(data[0].time);
  const startMs = newest.getTime() - (windowDays - 1) * 86400000;
  const dayStart = new Date(startMs); dayStart.setHours(0,0,0,0);
  let total = 0;
  const daysSeen = new Set();
  for(const e of data){
    const t = new Date(e.time);
    if(t.getTime() < dayStart.getTime()) break;   // sorted; nothing older matters
    total += (e.amountMcg || 0);
    daysSeen.add(t.toDateString());
  }
  if(total <= 0) return null;
  // Divide by the actual span covered (newest day back to oldest day in window),
  // so a partial window still gives a fair per-day rate.
  const oldestInWin = new Date(Math.max(dayStart.getTime(),
      new Date(data[data.length-1].time).getTime()));
  const spanDays = Math.max(1,
      Math.round((new Date(newest).setHours(0,0,0,0) - new Date(oldestInWin).setHours(0,0,0,0)) / 86400000) + 1);
  const span = Math.min(windowDays, spanDays);
  return { avg: total / span, span };
}

function renderRxRemaining(){
  const amtEl = document.getElementById('rxAmt');
  const daysEl = document.getElementById('rxDays');
  const noteEl = document.getElementById('rxNote');
  if(!amtEl) return;
  const mcg = rxGet();
  amtEl.classList.remove('low','empty');
  if(daysEl) daysEl.classList.remove('low','empty');

  if(mcg === null){
    amtEl.textContent = 'not set';
    if(daysEl) daysEl.textContent = '—';
    if(noteEl) noteEl.innerHTML = 'Tap <b>edit</b> to enter what’s left in your current script. Each dose you log is subtracted automatically.';
    return;
  }

  const shown = Math.max(0, mcg);
  amtEl.textContent = fmtAmt(shown);
  if(shown <= 0)            amtEl.classList.add('empty');
  else if(shown < 3750)     amtEl.classList.add('low');

  // ── days-left estimate from the last-10-days daily average ──
  const WIN = 10;
  const r = rxRecentDailyAvg(WIN);
  if(!daysEl) return;
  if(!r || r.avg <= 0){
    daysEl.textContent = '—';
    if(noteEl) noteEl.innerHTML = 'Log a few doses and this estimates days left from your recent daily average.';
    return;
  }
  if(shown <= 0){
    daysEl.textContent = '0';
    daysEl.classList.add('empty');
  } else {
    const days = shown / r.avg;
    daysEl.textContent = (days >= 10 ? Math.round(days) : (Math.round(days*10)/10)).toString();
    if(days < 5)       daysEl.classList.add('empty');
    else if(days < 10) daysEl.classList.add('low');
  }
  if(noteEl){
    noteEl.innerHTML = 'Days left = remaining ÷ average daily use over the last ' + WIN +
      ' days (≈ <b>' + fmtAmt(r.avg) + '/day</b>). Estimate only — it shifts as your dosing changes.';
  }
}

// Subtract a logged dose from the balance (no-op if never set).
function rxApplyDose(mcg){
  const cur = rxGet();
  if(cur === null) return;              // not tracking yet — don't start silently
  rxSet(cur - mcg);
}
// Put a deleted dose back (called from deleteEntry).
function rxRestoreDose(mcg){
  const cur = rxGet();
  if(cur === null) return;
  rxSet(cur + mcg);
}

// Edit the balance behind an "are you sure?" confirm.
function editRxRemaining(){
  const cur = rxGet();
  const unit = simUnit;                 // 'mcg' or 'mg'
  const curDisp = cur === null ? ''
      : (unit === 'mg' ? (Math.round(cur/1000*1000)/1000) : Math.round(cur));
  const entry = prompt(
    'Set the amount remaining in your current prescription (in ' + unit + ').\n' +
    'Each dose you log is subtracted from this automatically.',
    curDisp);
  if(entry === null) return;            // cancelled
  const trimmed = entry.trim();
  if(trimmed === ''){                   // clearing the tracker
    if(!confirm('Clear the prescription-remaining tracker? This stops tracking until you set it again.')) return;
    try{ localStorage.removeItem(RX_KEY); }catch(e){}
    renderRxRemaining();
    return;
  }
  const val = parseFloat(trimmed);
  if(isNaN(val) || val < 0){ alert('Enter a number of ' + unit + ' (0 or more).'); return; }
  const mcg = unit === 'mg' ? val * 1000 : val;
  if(!confirm('Set prescription remaining to ' + fmtAmt(mcg) + '?\nAre you sure?')) return;
  rxSet(mcg);
}

// ─── override logDose to include symptom scores ───────────────────────────────
const _origLogDose = logDose;
// redefine logDose
function logDose() {
  const t = document.getElementById('logTime').value;
  const raw = parseFloat(document.getElementById('logDose').value);
  const n = document.getElementById('logNotes').value.trim();
  if (!t || !raw || raw <= 0) { alert('Enter a valid time and dose.'); return; }
  const d = simUnit === 'mg' ? raw * 1000 : raw;   // always store internally in mcg
  const data = loadData();
  const entry = {
    time: t, amountMcg: d, drug: 'bup', form: 'Sublingual film',
    notes: n, symptoms: null,
    cravings: sympOpen ? cravScore : null,
    effect: sympOpen ? effectScore : null
  };
  data.push(entry);
  saveData(data);
  rxApplyDose(d);   // subtract this dose from the prescription balance
  document.getElementById('logDose').value = '';
  document.getElementById('logNotes').value = '';
  // reset symptom panel
  cravScore = 5; effectScore = 5;
  if (sympOpen) { toggleSympPanel(); }
  setLogTimeNow();
  renderHistory();
  renderPkChart();
  try{ updateNowBlock(); renderAvgDoses(); }catch(e){}
  renderRxRemaining();
}

// ─── override renderHistory to show cravings/effect dots ─────────────────────
const _baseRenderHistory = renderHistory;
function renderHistory() {
  const data = getData();
  const total = data.length;
  const search = document.getElementById('histSearch').value.toLowerCase();
  const days = parseInt(document.getElementById('histDays').value);
  const cutoff = days > 0 ? new Date(Date.now() - days * 86400000) : new Date(0);
  const filtered = data.filter(r => new Date(r.time) >= cutoff && (!search || (r.notes||'').toLowerCase().includes(search)));
  const tbody = document.getElementById('histBody');
  tbody.innerHTML = '';
  try{ updateNowBlock(); }catch(e){}
  if (!filtered.length) {
    const tr = document.createElement('tr');
    tr.innerHTML = '<td colspan="6" style="text-align:center;padding:20px;color:var(--text3);font-size:12px">No entries in this range.</td>';
    tbody.appendChild(tr); document.getElementById('histCount').textContent = 'showing 0 of ' + total + ' total entries'; return;
  }
  filtered.forEach(r => {
    const dt = new Date(r.time);
    const cDot = r.cravings != null ? `<span title="cravings: ${r.cravings}/10" style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${scoreColor(r.cravings,'crav')};vertical-align:middle"></span> ${r.cravings}` : '<span style="color:var(--text3)">—</span>';
    const eDot = r.effect != null ? `<span title="effect: ${r.effect}/10" style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${scoreColor(r.effect,'effect')};vertical-align:middle"></span> ${r.effect}` : '<span style="color:var(--text3)">—</span>';
    const tr = document.createElement('tr');
    tr.innerHTML = `<td class="time-cell">${dt.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})} ${dt.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})}</td><td class="dose-cell">${fmtAmt(r.amountMcg)}</td><td style="font-size:11px;white-space:nowrap">${cDot}</td><td style="font-size:11px;white-space:nowrap">${eDot}</td><td style="color:var(--text2)">${r.notes||''}</td><td><button class="del-btn" onclick="deleteEntry('${r.time}',${r.amountMcg})">×</button></td>`;
    tbody.appendChild(tr);
  });
  const shownLabel = (days > 0 || search) ? ('showing ' + filtered.length + ' of ' + total + ' total entries') : (total + ' entries');
  document.getElementById('histCount').textContent = shownLabel;
}

// ─── clinician / instance ID ──────────────────────────────────────────────────
const INST_KEY = 'st_instanceId';
const CLIN_SKIP_KEY = 'st_clinSkip';

function genInstanceId() {
  const arr = new Uint8Array(12);
  crypto.getRandomValues(arr);
  return Array.from(arr).map(b => b.toString(16).padStart(2,'0')).join('').toUpperCase().match(/.{4}/g).join('-');
}

function getInstanceId() {
  let id = localStorage.getItem(INST_KEY);
  if (!id) { id = genInstanceId(); localStorage.setItem(INST_KEY, id); }
  return id;
}

function regenInstanceId() {
  if (!confirm('Regenerate your Instance ID? Your clinician will need the new ID to continue accessing your records.')) return;
  const id = genInstanceId();
  localStorage.setItem(INST_KEY, id);
  document.getElementById('instanceIdDisplay').textContent = id;
}

function copyInstanceId() {
  const id = document.getElementById('instanceIdDisplay').textContent;
  navigator.clipboard.writeText(id).then(() => {
    const btn = event.target; btn.textContent = 'copied ✓';
    setTimeout(() => btn.textContent = 'copy id', 2000);
  });
}

function openClinician() {
  const skip = localStorage.getItem(CLIN_SKIP_KEY) === '1';
  if (skip) { enterClinician(); return; }
  document.getElementById('clinicianModal').style.display = 'flex';
}

function closeClinModal() {
  document.getElementById('clinicianModal').style.display = 'none';
}

function saveClinModalPref() {
  const checked = document.getElementById('clinModalDontShow').checked;
  localStorage.setItem(CLIN_SKIP_KEY, checked ? '1' : '0');
}

function enterClinician() {
  closeClinModal();
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('panel-clinician').classList.add('active');
  document.getElementById('clinicianNavBtn').classList.add('active');
  document.getElementById('instanceIdDisplay').textContent = getInstanceId();
  renderAvgDoses();
}

function lookupPatient() {
  const id = document.getElementById('patientIdInput').value.trim().toUpperCase();
  const result = document.getElementById('patientResult');
  if (!id) { result.textContent = 'Enter an Instance ID.'; return; }
  // In a local-only app, patient lookup is not possible without data sharing infrastructure.
  // This placeholder explains the current limitation clearly.
  result.innerHTML = `<div style="padding:10px;background:var(--bg3);border-radius:var(--radius);border:1px solid var(--border);line-height:1.7">
    <div style="font-weight:700;color:var(--text);margin-bottom:4px">Instance ID: ${id}</div>
    <div style="color:var(--text3);font-size:11px">Patient lookup requires the patient to share their exported JSON directly. Ask the patient to use <strong style="color:var(--text2)">export json</strong> from their History tab and send you the file. You can then view their records by importing the file here.</div>
    <div style="margin-top:8px"><input type="file" accept=".json" onchange="loadPatientFile(event)" style="font-size:11px;color:var(--text2)"></div>
  </div>`;
}

function loadPatientFile(e) {
  const file = e.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    try {
      const data = JSON.parse(ev.target.result);
      if (!Array.isArray(data)) throw new Error('invalid format');
      const result = document.getElementById('patientResult');
      const total = data.length;
      const latest = data.sort((a,b)=>new Date(b.time)-new Date(a.time))[0];
      const earliest = data[data.length-1];
      result.innerHTML += `<div style="margin-top:10px;padding:10px;background:var(--accentbg);border-radius:var(--radius);border:1px solid var(--border);font-size:11px;line-height:1.8">
        <div style="font-weight:700;color:var(--accent);margin-bottom:4px">File loaded — ${total} entries</div>
        <div>First entry: ${earliest.time} &nbsp;·&nbsp; ${earliest.amountMcg} mcg</div>
        <div>Latest entry: ${latest.time} &nbsp;·&nbsp; ${latest.amountMcg} mcg</div>
        <div style="margin-top:8px;color:var(--text3)">Review this data in a separate session by importing it into a new browser tab running The Smack Tracker.</div>
      </div>`;
    } catch(err) { document.getElementById('patientResult').innerHTML += '<div style="color:var(--red);font-size:11px;margin-top:6px">Could not read file: ' + err.message + '</div>'; }
  };
  reader.readAsText(file);
}

// ─── cutting guide ────────────────────────────────────────────────────────────
// Official Suboxone sublingual film dimensions (FDA/manufacturer specifications)
// Source: Suboxone USPI Table 1, Reckitt Benckiser
// Note: 2mg and 8mg are physically identical (22×12.8mm); dose differs by concentration only.
// The 4mg film is compositionally identical to 2mg but twice the length.
// The 12mg film is compositionally identical to 8mg but 1.5× the length.

// Official Suboxone sublingual film dimensions (FDA/manufacturer specifications)
// Grid cols×rows chosen to produce cells as close to square as possible.
// 2mg and 8mg are physically identical (22×12.8mm); dose differs by concentration only.
const FILMS = {
  '2mg': {
    label: '2mg / 0.5mg (buprenorphine/naloxone)',
    w: 22.0, h: 12.8, totalMcg: 2000,
    note: 'Same physical size as the 8mg film. Verify your strip by reading the imprint (N2) before cutting.',
    divisions: [
      { n: 6,  cols: 3, rows: 2, desc: '333.3 mcg per piece' },
      { n: 8,  cols: 4, rows: 2, desc: '250 mcg per piece' },
      { n: 16, cols: 4, rows: 4, desc: '125 mcg per piece' },
      { n: 20, cols: 5, rows: 4, desc: '100 mcg per piece' },
      { n: 40, cols: 8, rows: 5, desc: '50 mcg per piece' },
      { n: 80, cols: 10, rows: 8, desc: '25 mcg per piece' },
    ]
  },
  '4mg': {
    label: '4mg / 1mg (buprenorphine/naloxone)',
    w: 22.0, h: 25.6, totalMcg: 4000,
    note: 'Double the length of the 2mg film, same concentration per mm². Imprint: N4.',
    divisions: [
      { n: 6,  cols: 2, rows: 3,  desc: '666.7 mcg per piece' },
      { n: 8,  cols: 2, rows: 4,  desc: '500 mcg per piece' },
      { n: 16, cols: 4, rows: 4,  desc: '250 mcg per piece' },
      { n: 20, cols: 4, rows: 5,  desc: '200 mcg per piece' },
      { n: 40, cols: 5, rows: 8,  desc: '100 mcg per piece' },
      { n: 80, cols: 8, rows: 10, desc: '50 mcg per piece' },
    ]
  },
  '8mg': {
    label: '8mg / 2mg (buprenorphine/naloxone)',
    w: 22.0, h: 12.8, totalMcg: 8000,
    note: 'Same physical size as the 2mg film — 3.2× higher concentration per mm². Imprint: N8. Do not confuse with the 2mg.',
    divisions: [
      { n: 6,  cols: 3, rows: 2, desc: '1,333.3 mcg (1.33mg) per piece' },
      { n: 8,  cols: 4, rows: 2, desc: '1,000 mcg (1mg) per piece' },
      { n: 16, cols: 4, rows: 4, desc: '500 mcg per piece' },
      { n: 20, cols: 5, rows: 4, desc: '400 mcg per piece' },
      { n: 40, cols: 8, rows: 5, desc: '200 mcg per piece' },
      { n: 80, cols: 10, rows: 8, desc: '100 mcg per piece' },
    ]
  },
  '12mg': {
    label: '12mg / 3mg (buprenorphine/naloxone)',
    w: 22.0, h: 19.2, totalMcg: 12000,
    note: '1.5× the length of the 8mg film, same concentration per mm². Imprint: N12.',
    divisions: [
      { n: 6,  cols: 3, rows: 2, desc: '2,000 mcg (2mg) per piece' },
      { n: 8,  cols: 4, rows: 2, desc: '1,500 mcg (1.5mg) per piece' },
      { n: 16, cols: 4, rows: 4, desc: '750 mcg per piece' },
      { n: 20, cols: 5, rows: 4, desc: '600 mcg per piece' },
