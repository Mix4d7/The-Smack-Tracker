}

// ── Absorption timeline readout ─────────────────────────────────────────────
// Shows how a single dose climbs to its own peak, in real time terms.
const ABS_MARKS = [15, 30, 45, 60, 90, 120, 180, 240];
function renderAbsorptionTimeline(){
  const host = document.getElementById('absTimeline');
  if(!host) return;
  const tmax = getPkTmax();
  const rows = ABS_MARKS.map(min=>{
    const pct = pkFractionOfPeak(min/60) * 100;
    const lbl = min < 60 ? (min + ' min')
              : (min % 60 === 0 ? (min/60) + ' hr' : (Math.floor(min/60) + 'h' + (min%60) + 'm'));
    return '<div class="abs-row">'+
             '<span class="abs-t">'+lbl+'</span>'+
             '<span class="abs-bar"><i style="width:'+pct.toFixed(1)+'%"></i></span>'+
             '<span class="abs-p">'+pct.toFixed(0)+'%</span>'+
           '</div>';
  }).join('');
  host.innerHTML =
    '<div class="abs-head">absorption of a single dose &middot; % of that dose\u2019s own peak</div>' +
    rows;
}

function _v20InitPkUI(){ syncPkHalfLifeUI(); renderAbsorptionTimeline(); }
function updatePkFooter() {
  // Technical model-parameter dump removed per request — the footer keeps
  // its plain-language text (set in the HTML) instead of being overwritten.
}

let pkChart=null, pkRangeKey='10d';
let pkModifierOn=false;          // Modifier variability band toggle
let pkCustomRange=null;          // {start, end} in ms when a custom date range is active

// ═══ PET-calibrated pharmacodynamic pipeline ═══════════════════════════════
// The app converts logged doses into an estimate of μ-opioid RECEPTOR OCCUPANCY,
// because occupancy — not milligrams — is what tracks the biology, and it's what
// makes low-dose tapering legible. Every box runs this one frozen chain:
//
//   (1) dose log → accumulated dose-equivalent (mcg)   [existing 1-cpt model,
//        t½=36h, Tmax=2h]  — this gives the correct time SHAPE.
//   (2) dose-equivalent → plasma concentration (ng/mL) via a power law that
//        captures buprenorphine's well-documented LESS-than-dose-proportional
//        absorption:  C = PD_A * (equiv)^PD_P
//   (3) plasma → occupancy (%) via the published saturable Emax model:
//        occ = EMAX * C / (EC50 + C)
//
// Calibration (all fixed, from direct PET [11C]carfentanil data, Greenwald 2003):
//   measured occupancy 41% @2mg, 80% @16mg, 84% @32mg;
//   peak plasma 0.6, 5.5, 13.5 ng/mL respectively.
//   Emax=91%, EC50=0.67 ng/mL (Nasser 2014 / Indivior pop-PK/PD).
//   PD_A, PD_P are fit so C(equiv) passes through the 2mg & 16mg plasma points.
// Result reproduces PET: 2mg→43%, 16mg→81%, 32mg→87%. Frozen — no user knobs.
const PD_EMAX = 91;        // % maximum occupancy
const PD_EC50 = 0.67;      // ng/mL at half-max
const PD_A    = 6.2905e-5; // ng/mL per (mcg-equiv)^PD_P
const PD_P    = 1.0655;    // less-than-dose-proportional exponent

// Within-person dose-to-dose absorption variability: within-subject CV ≈ 34%
// (Bullingham; used as dose-bioavailability CV in a published SL-bup PBPK model).
// Applied as ±1 SD on the dose-equivalent before the ng/mL + occupancy chain.
const PK_VAR_SD = 0.34;

// Clinical reference occupancies (derived in ACTIVE-USE context — shown for
// orientation only, NOT as pass/fail for a low-dose taperer):
//   ~50% occ ≈ withdrawal-suppression threshold (Greenwald)
//   ~70% occ ≈ treatment-optimal / blockade target
const OCC_WITHDRAWAL = 50;
const OCC_OPTIMAL    = 70;

// Taper-endpoint landmarks (from clinical taper literature, mapped through this
// same model so they stay internally consistent):
//   ~40% occ  ≈ the "2 mg wall" — the widely-cited hardest step of a taper,
//               where 2 mg/day still holds ~40% of receptors and clinicians
//               switch to 0.25–0.5 mg decrements.
//   ~8–15% occ ≈ typical JUMP-OFF ZONE — the 0.25–0.5 mg/day doses people
//               usually discontinue from (often with clinician support / comfort
//               meds), rather than cutting further. The goal is to REACH this
//               zone and stop — not to chase occupancy toward zero.
const OCC_TWO_MG_WALL = 40;
const OCC_JUMP_HI     = 15;   // ~0.5 mg/day
const OCC_JUMP_LO     = 8;    // ~0.25 mg/day

// dose-equivalent (mcg) → plasma concentration (ng/mL)
function equivToNgml(equivMcg){
  if(equivMcg <= 0) return 0;
  return PD_A * Math.pow(equivMcg, PD_P);
}
// plasma concentration (ng/mL) → μOR occupancy (%)
function ngmlToOcc(C){
  if(C <= 0) return 0;
  return PD_EMAX * C / (PD_EC50 + C);
}
// dose-equivalent (mcg) → occupancy (%), the full frozen chain
function equivToOcc(equivMcg){
  return ngmlToOcc(equivToNgml(equivMcg));
}

// ── Inverse of the frozen chain: occupancy (%) → dose-equivalent (mcg) ────────
// occupancy → ng/mL:  occ = EMAX·C/(EC50+C)  ⇒  C = EC50·occ/(EMAX−occ)
// ng/mL → equiv:      C = A·equiv^P          ⇒  equiv = (C/A)^(1/P)
// Used to label the occupancy reference lines with their approximate mcg/mg
// dose-equivalent, so both estimates are always shown together.
function occToNgml(occ){
  if(occ <= 0) return 0;
  if(occ >= PD_EMAX) return Infinity;
  return PD_EC50 * occ / (PD_EMAX - occ);
}
function ngmlToEquiv(C){
  if(C <= 0) return 0;
  return Math.pow(C / PD_A, 1 / PD_P);
}
function occToEquiv(occ){
  return ngmlToEquiv(occToNgml(occ));
}
// ── Occupancy display precision (v1.17) ─────────────────────────────────────
// Occupancy is reported to the nearest 0.01% everywhere it is shown. The
// underlying Emax chain is continuous, so the old whole-number rounding was
// throwing away real resolution — at low dose especially, a 0.25 mg decrement
// can move occupancy by well under one point, and that motion was invisible.
// This formats only; no model constant changed.
const OCC_DP = 2;
function fmtOcc(occ){
  if(!isFinite(occ)) return '—';
  return occ.toFixed(OCC_DP);
}
function fmtOccPct(occ){ return fmtOcc(occ) + '%'; }

// ── Zone label (v2.7, revised v3.1) ─────────────────────────────────────
// Occupancy as a NAMED ZONE rather than a decimal — the decimal implies a
// precision the at-home model can't actually deliver.
//
// v3.1: band narrowed based on further reading. 0.125 mg/day intake is
// treated as the point where the discomfort of reducing further matches
// the discomfort of stopping outright; below ~25 mcg/day, intake is
// effectively indistinguishable from 0 (25 mcg is roughly the smallest
// perceptible dose change). So the intake range is 25–125 mcg/day. Run
// through the same steady-state accumulation math used elsewhere in the
// app (once-daily dosing, 36hr half-life): 25 mcg/day settles to a
// trough/peak of roughly 47/69 mcg-equiv; 125 mcg/day settles to roughly
// 236/346 mcg-equiv. The band shown is the full envelope: low intake's
// trough up to high intake's peak. See disclaimers for the full caveat
// (this is still consensus/estimate, not a measured dose-response curve,
// and doesn't include the ~34% day-to-day absorption variability).
const JUMP_ZONE_LO_MCG = 47;   // trough at steady state, 25 mcg/day intake
const JUMP_ZONE_HI_MCG = 346;  // peak at steady state, 125 mcg/day intake
// v3.6: second band above the jump-off zone — 0.125-0.5 mg/day intake, where
// people who CAN often do stop with support (clinician, stable life
// circumstances, sometimes detox meds), but with real discomfort rather than
// full withdrawal. Stacked directly on top of the jump-off band (continuous
// at 346, the top of that band) rather than restarting from 125mg's own
// trough, so the two shaded areas read as one continuous scale with no gap
// or overlap. Top of this band (peak at 500 mcg/day) is where stopping
// outright would mean moderate-to-severe withdrawal.
const SUPPORT_ZONE_LO_MCG = JUMP_ZONE_HI_MCG; // 346 — continuous with jump-off zone
const SUPPORT_ZONE_HI_MCG = 1385;             // peak at steady state, 500 mcg/day intake
function occZoneLabel(occ){
  const eq = occToEquiv(occ);
  if(!isFinite(eq)) return 'above support-assisted range';
  if(eq < JUMP_ZONE_LO_MCG) return 'below typical jump-off';
  if(eq <= JUMP_ZONE_HI_MCG) return 'jump-off zone';
  if(eq <= SUPPORT_ZONE_HI_MCG) return 'support-assisted stop range';
  return 'above support-assisted range';
}

// Format an occupancy % as its dose-equivalent, respecting the current unit.
// Returns e.g. "~2 mg" or "~750 mcg". Clamps absurd values.
function occToDoseLabel(occ){
  const eq = occToEquiv(occ);
  if(!isFinite(eq) || eq <= 0) return '';
  return '~' + fmtAmt(eq);
}

const PK_RANGES=[
  {key:'24h',  label:'24 hours', days:1},
  {key:'72h',  label:'72 hours', days:3},
  {key:'10d',  label:'10 days',  days:10},
  {key:'1mo',  label:'1 month',  days:30},
  {key:'3mo',  label:'3 months', days:91},
  {key:'6mo',  label:'6 months', days:182},
  {key:'9mo',  label:'9 months', days:274},
  {key:'1yr',  label:'1 year',   days:365},
  {key:'all',  label:'all time', days:0},
];

function buildRangeBar(){
  const bar=document.getElementById('pkRangeBar');
  bar.innerHTML='';
  const active=k=>!pkCustomRange&&k===pkRangeKey;
  PK_RANGES.forEach(r=>{
    const btn=document.createElement('button');
    btn.className='range-pill'+(active(r.key)?' active':'');
    btn.textContent=r.label;
    btn.onclick=()=>{pkCustomRange=null;syncPkDateInputs();pkRangeKey=r.key;buildRangeBar();renderPkChart();};
    bar.appendChild(btn);
  });
  // dynamic year pills — one per year detected in the data
  const data=loadData();
  if(data.length){
    const years=[...new Set(data.map(r=>new Date(r.time).getFullYear()))].sort();
    // only bother when the data spans more than one calendar year
    if(years.length>1){
      years.forEach(yr=>{
        const btn=document.createElement('button');
        btn.className='range-pill'+(active(String(yr))?' active':'');
        btn.textContent=String(yr);
        btn.dataset.yr=yr;
        btn.onclick=()=>{pkCustomRange=null;syncPkDateInputs();pkRangeKey=String(yr);buildRangeBar();renderPkChart();};
        bar.insertBefore(btn,bar.children[bar.children.length-1]);
      });
    }
  }
}

function getPkWindow(){
  if(pkCustomRange) return {start:pkCustomRange.start, end:pkCustomRange.end};
  const range=PK_RANGES.find(r=>r.key===pkRangeKey)||(()=>{
    // year key
    const yr=parseInt(pkRangeKey);
    if(!isNaN(yr))return{year:yr};
    return{days:30};
  })();
  const now=nowMs();
  if(range.year){
    return{start:new Date(range.year,0,1).getTime(), end:new Date(range.year+1,0,1).getTime()};
  }
  if(range.days===0){
    const data=loadData();
    if(!data.length)return{start:now-30*86400000,end:now+86400000};
    const earliest=Math.min(...data.map(r=>new Date(r.time).getTime()));
    return{start:earliest-3600000,end:now+86400000};
  }
  return{start:now-range.days*86400000,end:now+3600000};
}

function simulatePkSeries(data, windowStart, windowEnd){
  const sorted=[...data].sort((a,b)=>new Date(a.time)-new Date(b.time));
  if(!sorted.length)return{times:[],levels:[]};

  // Include all doses up to windowEnd that could still contribute at windowStart
  // Cutoff: doses more than 7 half-lives before windowStart contribute < 1% — ignore them
  const ignoreCutoffMs = windowStart - 7 * pkParams.tHalf * 3600000;
  const doses = sorted.filter(r => {
    const ms = new Date(r.time).getTime();
    return ms >= ignoreCutoffMs && ms <= windowEnd;
  });

  // Adaptive resolution
  const windowHours = (windowEnd - windowStart) / 3600000;
  let dtHours;
  if      (windowHours <= 72)   dtHours = 0.1;
  else if (windowHours <= 720)  dtHours = 0.5;
  else if (windowHours <= 4380) dtHours = 2;
  else                           dtHours = 6;

  const times=[], levels=[];
  const dtMs = dtHours * 3600000;

  for(let ms = windowStart; ms <= windowEnd; ms += dtMs){
    let lv = 0;
    for(const dose of doses){
      const doseMs = new Date(dose.time).getTime();
      if(doseMs > ms) break; // doses are sorted ascending
      const tH = (ms - doseMs) / 3600000;
      lv += pkConc(dose.amountMcg, tH);
    }
    times.push(ms);
    levels.push(parseFloat(lv.toFixed(1)));
  }
  return{times, levels};
}

// ── Sustained-reduction detector ───────────────────────────────────────────────
// Samples occupancy once per day across [start,end], then finds the longest
// stretch over which occupancy is trending DOWN (a taper). If such a stretch
// lasts at least 2 weeks, returns its total drop, duration, and average
// per-week reduction so the dashboard can surface it. Small day-to-day upticks
// (dosing noise) inside an overall downtrend don't break the run.
const REDUCTION_MIN_DAYS = 14;      // must be sustained ≥ 2 weeks
function detectSustainedReduction(data, start, end){
  const DAY=86400000;
  // Daily occupancy samples (trough-ish: sample at same clock time each day).
  const samples=[];
  for(let ms=start; ms<=end; ms+=DAY){
    let lv=0;
    for(const d of data){
      const dm=new Date(d.time).getTime();
      if(dm>ms) continue;
      const tH=(ms-dm)/3600000;
      if(tH > 12*pkParams.tHalf) continue;
      lv+=pkConc(d.amountMcg, tH);
    }
    samples.push({ms, occ:equivToOcc(lv)});
  }
  if(samples.length < REDUCTION_MIN_DAYS) return null;

  // Grow the longest non-increasing run (tolerate tiny bumps up to 1.5 pts).
  const TOL=1.5;
  let best=null, runStart=0, peakIdx=0;
  for(let i=1;i<samples.length;i++){
    // If occupancy rises meaningfully above the running peak, the downtrend broke.
    if(samples[i].occ > samples[peakIdx].occ + TOL){
      runStart=i; peakIdx=i; continue;
    }
    if(samples[i].occ < samples[peakIdx].occ) peakIdx=i; // new low extends run
    const drop=samples[runStart].occ - samples[i].occ;
    const days=(samples[i].ms - samples[runStart].ms)/DAY;
    if(drop>0.5 && days>=REDUCTION_MIN_DAYS){
      if(!best || days>best.days || (Math.abs(days-best.days)<0.5 && drop>best.drop)){
        best={startMs:samples[runStart].ms, endMs:samples[i].ms, days,
              startOcc:samples[runStart].occ, endOcc:samples[i].occ, drop};
      }
    }
  }
  if(!best) return null;
  best.perWeek = best.drop / (best.days/7);
  return best;
}
function renderReductionBox(data, start, end){
  const el=document.getElementById('pkReduction');
  if(!el) return;
  const r=detectSustainedReduction(data, start, end);
  if(!r){ el.style.display='none'; return; }
  const fmtD=ms=>{const d=new Date(ms);return (d.getMonth()+1)+'/'+d.getDate()+'/'+String(d.getFullYear()).slice(2);};
  const startEq=occToEquiv(r.startOcc), endEq=occToEquiv(r.endOcc);
  const pctDrop = (isFinite(startEq)&&startEq>0) ? ((startEq-endEq)/startEq*100) : null;
  el.innerHTML =
    '<b>sustained reduction detected</b> · '+Math.round(r.days)+' days ('+fmtD(r.startMs)+' → '+fmtD(r.endMs)+')<br>'+
    'average reduction: '+(pctDrop!==null?('<b>'+pctDrop.toFixed(0)+'%</b> total dose-equivalent'):'')+
    ', from '+(isFinite(startEq)?fmtAmt(startEq):'—')+' ('+occZoneLabel(r.startOcc)+') '+
    'to '+(isFinite(endEq)?fmtAmt(endEq):'—')+' ('+occZoneLabel(r.endOcc)+')';
  el.style.display='block';
}

// ══ WINDOW INTERPRETATION ENGINE (v2.4) ═════════════════════════════════════
// Everything the graph shows, read back in plain numbers to the left of it:
// average peak & trough (occupancy % + mcg-equiv), average daily dose, and —
// for windows of 7 days or more — whether the level is trending up, down, or
// holding, and by how much. Uses the same PK/occupancy chain as the chart, so
// the panel and the curve can never disagree.

const TREND_MIN_DAYS = 7;          // trend needs at least a week of span
const TREND_FLAT_PTS_WK = 0.4;     // |slope| under this = "holding steady"
const avgOf = a => a.length ? a.reduce((x,y)=>x+y,0)/a.length : 0;

// Local peaks & troughs on a level series (dose-equivalent mcg).
function findExtrema(levels){
  const peaks=[], troughs=[];
  for(let i=1;i<levels.length-1;i++){
    if(levels[i]>=levels[i-1] && levels[i]>levels[i+1]) peaks.push(levels[i]);
    if(levels[i]<=levels[i-1] && levels[i]<levels[i+1]) troughs.push(levels[i]);
  }
  // Degenerate windows (flat/short) — fall back to global max/min so we still
  // report something rather than blanks.
  if(!peaks.length && levels.length)   peaks.push(Math.max(...levels));
  if(!troughs.length && levels.length) troughs.push(Math.min(...levels));
  return {peaks, troughs};
}

// Least-squares slope of daily trough occupancy over the window.
// Returns pts/week, net change across the span, and sample count — or null.
function analyzeTrend(data, start, end){
  const DAY=86400000;
  const xs=[], ys=[];
  for(let ms=start, idx=0; ms<end; ms+=DAY, idx++){
    const {levels}=simulatePkSeries(data, ms, Math.min(ms+DAY, end));
    if(!levels.length) continue;
    xs.push(idx);
    ys.push(equivToOcc(Math.min(...levels)));   // that day's trough occupancy
  }
  const n=xs.length;
  if(n < TREND_MIN_DAYS) return null;
  const mx=avgOf(xs), my=avgOf(ys);
  let num=0, den=0;
  for(let i=0;i<n;i++){ num+=(xs[i]-mx)*(ys[i]-my); den+=(xs[i]-mx)**2; }
  if(den===0) return null;
  const slopeDay=num/den;
  return {
    perWeek: slopeDay*7,
    net: slopeDay*(n-1),
    firstOcc: ys[0], lastOcc: ys[n-1],
    days: n
  };
}

// Average dose PER DAY across the window (mcg). Uses calendar span so a
// long quiet window isn't flattered by a couple of doses.
function windowAvgDose(data, start, end){
  let total=0, doses=0;
  for(const d of data){
    const ms=new Date(d.time).getTime();
    if(ms>=start && ms<=end){ total+=(d.amountMcg||0); doses++; }
  }
  const spanDays=Math.max(1,(end-start)/86400000);
  return {perDay: total/spanDays, perDose: doses?total/doses:0, doses, spanDays};
}

function currentRangeLabel(){
  if(pkCustomRange){
    const f=ms=>{const d=new Date(ms);return (d.getMonth()+1)+'/'+d.getDate()+'/'+String(d.getFullYear()).slice(2);};
    return f(pkCustomRange.start)+' → '+f(pkCustomRange.end);
  }
  const r=PK_RANGES.find(x=>x.key===pkRangeKey);
  if(r) return r.label;
  if(!isNaN(parseInt(pkRangeKey))) return 'year '+pkRangeKey;
  return pkRangeKey;
}

function renderPkInterp(data, start, end, levels){
  const host=document.getElementById('pkInterp');
  if(!host) return;

  if(!levels || !levels.length || !data.length){
    host.innerHTML='<div class="ip-head">reading the graph</div>'+
      '<div class="ip-empty">No doses in this window yet. Once there are, this panel breaks the curve down into average peak, trough, dose, and trend.</div>';
    return;
  }

  const {peaks, troughs}=findExtrema(levels);
  const avgPeakEq=avgOf(peaks), avgTroughEq=avgOf(troughs);
  const avgPeakOcc=equivToOcc(avgPeakEq), avgTroughOcc=equivToOcc(avgTroughEq);
  const swing=avgPeakOcc-avgTroughOcc;
  const dose=windowAvgDose(data, start, end);

  const pairPk = '<div class="ip-pair"><span class="ip-k">peak</span>'+
    '<span class="ip-v">'+fmtAmt(avgPeakEq)+'</span></div>';
  const pairTr = '<div class="ip-pair"><span class="ip-k">trough</span>'+
    '<span class="ip-v">'+fmtAmt(avgTroughEq)+'</span></div>';
  const swPct = avgTroughEq>0 ? ((avgPeakEq-avgTroughEq)/avgTroughEq*100) : 0;
  const pairSw = '<div class="ip-pair"><span class="ip-k">peak-to-trough swing</span>'+
    '<span class="ip-v">'+swPct.toFixed(0)+'%</span></div>';

  const doseBlock = '<div class="ip-block"><div class="ip-lbl">average dose</div>'+
    '<div class="ip-pair"><span class="ip-k">per day</span><span class="ip-v">'+fmtAmt(dose.perDay)+'</span></div>'+
    '<div class="ip-pair"><span class="ip-k">per dose</span><span class="ip-v">'+fmtAmt(dose.perDose)+'</span></div>'+
    '</div>';

  // ── trend (≥7 days) ──
  let trendBlock='';
  const spanDays=(end-start)/86400000;
  if(spanDays >= TREND_MIN_DAYS){
    const t=analyzeTrend(data, start, end);
    if(t){
      let cls, dir;
      if(Math.abs(t.perWeek) < TREND_FLAT_PTS_WK){ cls='ip-flat'; dir='holding steady'; }
      else if(t.perWeek > 0){ cls='ip-up';   dir='trending upward'; }
      else                  { cls='ip-down'; dir='trending downward'; }
      // dose-equivalent of the net change, evaluated at the trough level
      const eqStart=occToEquiv(t.firstOcc), eqEnd=occToEquiv(t.lastOcc);
      const netEq = (isFinite(eqStart)&&isFinite(eqEnd)) ? (eqEnd-eqStart) : null;
      const sign = v => (v>=0?'+':'');
      const bymag = Math.abs(t.perWeek)<TREND_FLAT_PTS_WK
        ? 'essentially flat across '+t.days+' days'
        : (netEq!==null
            ? sign(netEq)+fmtAmt(Math.abs(netEq))+' net change across '+t.days+' days'
            : sign(t.net)+t.net.toFixed(1)+' pts net change across '+t.days+' days');
      trendBlock =
        '<div class="ip-block"><div class="ip-lbl">trend</div>'+
        '<div class="ip-trend '+cls+'"><span class="ip-dir">'+dir+'</span>'+bymag+'</div></div>';
    }
  } else {
    trendBlock='<div class="ip-block"><div class="ip-lbl">trend</div>'+
      '<div class="ip-empty" style="font-size:10.5px">Select 7 days or more to see whether the level is rising, falling, or holding.</div></div>';
  }

  host.innerHTML =
    '<div class="ip-head">reading the graph</div>'+
    '<div class="ip-window">'+currentRangeLabel()+'</div>'+
    '<div class="ip-block"><div class="ip-lbl">average level</div>'+pairPk+pairTr+pairSw+'</div>'+
    doseBlock+
    trendBlock;
}

function renderPkChart(){
  const data=loadData();
  const {start,end}=getPkWindow();
  const {times,levels}=simulatePkSeries(data,start,end);
  const c=chartColors();
  const windowHours=(end-start)/3600000;

  function fmtLabel(ms){
    const d=new Date(ms);
    if(windowHours<=72)
      return (d.getMonth()+1)+'/'+d.getDate()+' '+d.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
    if(windowHours<=720)
      return (d.getMonth()+1)+'/'+d.getDate();
    return (d.getMonth()+1)+'/'+d.getDate()+'/'+String(d.getFullYear()).slice(2);
  }

  // Decide tick density
  const maxTicks=windowHours<=72?12:windowHours<=720?14:12;
  const step=Math.ceil(times.length/maxTicks);
  const tickLabels=times.map((ms,i)=>i%step===0?fmtLabel(ms):'');

  // ── Primary series is dose-equivalent (mcg) on board — linear, so it
  // compares cleanly week to week. Occupancy % (the nonlinear, harder-to-pin
  // clinical read) is now secondary: shown as reference zones, not a headline
  // line. OFF: single dose-equivalent line. ON: ±1 SD absorption band applied
  // directly on the linear mcg value (no curve distortion to worry about here).
  const eqOf = eq => parseFloat(eq.toFixed(1));
  let datasets;
  if(pkModifierOn){
    const center = levels.map(eqOf);
    const upper  = levels.map(v=>eqOf(v*(1+PK_VAR_SD)));
    const lower  = levels.map(v=>eqOf(v*(1-PK_VAR_SD)));
    datasets=[
      { label:'+1 SD absorption', data:upper, borderColor:c.line, backgroundColor:'transparent',
        borderWidth:1, borderDash:[3,3], pointRadius:0, fill:false, tension:0 },
      { label:'dose-equivalent (est.)', data:center, borderColor:c.line, backgroundColor:c.fill,
        borderWidth:1.5, pointRadius:0, fill:'+1', tension:0 },
      { label:'−1 SD absorption', data:lower, borderColor:c.line, backgroundColor:'transparent',
        borderWidth:1, borderDash:[3,3], pointRadius:0, fill:false, tension:0 }
    ];
  } else {
    datasets=[{
      label:'dose-equivalent (est.)', data:levels.map(eqOf), borderColor:c.line, backgroundColor:c.fill,
      borderWidth:1.5, pointRadius:0, fill:true, tension:0
    }];
  }

  if(pkChart){pkChart.destroy();pkChart=null;}

  // mcg axis is data-driven (no fixed ceiling the way a 0-100% axis had).
  const plotted = datasets.flatMap(ds=>ds.data).filter(v=>typeof v==='number');
  let yMax = 1000;
  if(plotted.length){
    const dataMax = Math.max(...plotted, SUPPORT_ZONE_HI_MCG);
    yMax = Math.ceil((dataMax*1.15)/100)*100;
  }

  pkChart=new Chart(document.getElementById('pkChart'),{
    type:'line',
    data:{ labels:tickLabels, datasets },
    options:{
      responsive:true,maintainAspectRatio:false,animation:false,
      interaction:{mode:'index',intersect:false},
      plugins:{legend:{display:pkModifierOn,labels:{color:c.tick,font:{size:10,family:'Courier New'},boxWidth:14}},tooltip:{
        mode:'index',intersect:false,
        filter:ctx=>ctx.dataset.label==='dose-equivalent (est.)',
        callbacks:{
          title:ctx=>{const ms=times[ctx[0].dataIndex];return new Date(ms).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});},
          label:ctx=>{
            const eq=levels[ctx.dataIndex]||0;
            return fmtAmt(eq);
          }
        }
      }},
      scales:{
        x:{type:'category',ticks:{color:c.tick,font:{size:9,family:'Courier New'},maxRotation:45,autoSkip:true,maxTicksLimit:14},grid:{color:c.grid}},
        y:{min:0,max:yMax,ticks:{color:c.tick,font:{size:10,family:'Courier New'},callback:v=>fmtAmt(v)},grid:{color:c.grid},title:{display:true,text:'est. dose-equivalent on board (mcg)',color:c.tick,font:{size:9,family:'Courier New'}}}
      }
    },
    plugins:[{id:'occRefs', afterDraw(ch){
      const ctx=ch.ctx, yA=ch.scales.y, xA=ch.scales.x;
      // Minimum vertical gap (px) between two label baselines before we treat
      // them as colliding. The label font is 9px, so ~13px keeps them legible.
      const LABEL_MIN_GAP = 14;

      // Two zones shown on the graph, placed on the blood-level axis (see
      // occZoneLabel / SUPPORT_ZONE comments above for how the intake ranges
      // map to these blood-level bands):
      //  - darker band: the statistical jump-off zone (25-125 mcg/day intake)
      //  - lighter band above it: where people who CAN often stop with
      //    support, but with real discomfort rather than full withdrawal
      //    (0.125-0.5 mg/day intake)
      const jumpHiEq = JUMP_ZONE_HI_MCG;
      const jumpLoEq = JUMP_ZONE_LO_MCG;
      let jumpBot=null;
      if(yA.min <= jumpHiEq){
        const jTop=yA.getPixelForValue(Math.min(yA.max,jumpHiEq));
        const jBot=yA.getPixelForValue(Math.max(yA.min,jumpLoEq));
        if(jBot>jTop){
          jumpBot=jBot;
          ctx.save();
          ctx.fillStyle=c.blueDark;
          ctx.globalAlpha=0.28;
          ctx.fillRect(xA.left,jTop,xA.right-xA.left,jBot-jTop);
          ctx.globalAlpha=1;
          ctx.restore();
        }
      }

      const suppHiEq = SUPPORT_ZONE_HI_MCG;
      const suppLoEq = SUPPORT_ZONE_LO_MCG;
      let suppTop=null;
      if(yA.min <= suppHiEq){
        const sTop=yA.getPixelForValue(Math.min(yA.max,suppHiEq));
        const sBot=yA.getPixelForValue(Math.max(yA.min,suppLoEq));
        if(sBot>sTop){
          suppTop=sTop;
          ctx.save();
          ctx.fillStyle=c.blueLight;
          ctx.globalAlpha=0.14;
          ctx.fillRect(xA.left,sTop,xA.right-xA.left,sBot-sTop);
          ctx.globalAlpha=1;
          ctx.restore();
        }
      }

      ctx.save();
      if(jumpBot!==null){
        ctx.fillStyle=c.blueDark; ctx.font='bold 9px Courier New';
        ctx.fillText('statistical jump-off zone', xA.left+4, jumpBot+11);
      }
      if(suppTop!==null){
        ctx.fillStyle=c.blueLight; ctx.font='bold 9px Courier New';
        ctx.fillText('support-assisted stop range', xA.left+4, suppTop+11);
      }
      ctx.restore();
    }}]
  });

  // Surface the average reduction if a ≥2-week sustained taper is present.
  renderReductionBox(data, start, end);

  // Interpret the window to the left of the graph.
  renderPkInterp(data, start, end, levels);
}

// ── Modifier toggle + custom date range ───────────────────────────────────────
function onPkModToggle(){
  pkModifierOn=document.getElementById('pkModToggle').checked;
  rebuildPkChart();
  try{ updateNowBlock(); }catch(e){}
}
function syncPkDateInputs(){
  const s=document.getElementById('pkDateStart'), e=document.getElementById('pkDateEnd');
  if(!pkCustomRange){ if(s)s.value=''; if(e)e.value=''; document.getElementById('pkDateCount').textContent=''; }
}
function onPkDateRange(){
  const sv=document.getElementById('pkDateStart').value;
  const ev=document.getElementById('pkDateEnd').value;
  const cnt=document.getElementById('pkDateCount');
  if(!sv||!ev){ pkCustomRange=null; cnt.textContent=''; buildRangeBar(); renderPkChart(); return; }
  let start=new Date(sv+'T00:00').getTime();
  let end=new Date(ev+'T23:59').getTime();
  if(end<start){ const t=start; start=end-86340000; end=t+86340000; } // swap-safe
  pkCustomRange={start,end};
  const days=Math.max(1, Math.round((end-start)/86400000));
  cnt.textContent='= '+days+' day'+(days===1?'':'s');
  buildRangeBar();
  renderPkChart();
}
function clearPkDateRange(){
  pkCustomRange=null;
  document.getElementById('pkDateStart').value='';
  document.getElementById('pkDateEnd').value='';
  document.getElementById('pkDateCount').textContent='';
  buildRangeBar();
  renderPkChart();
}

function rebuildPkChart(){if(pkChart){pkChart.destroy();pkChart=null;}renderPkChart();}

// ─── present occupancy + dashboard status ──────────────────────────────────────
// Uses the same 1-cpt model as the peaks & troughs chart, then the frozen
// dose-equivalent → ng/mL → occupancy chain, so every box agrees.
// Dose-equivalent (mcg) on board at an arbitrary time `atMs`.
function doseEquivAtMs(atMs){
  const data = loadData();
  const cutoffH = 12 * pkParams.tHalf;   // beyond this a dose contributes <0.03%
  let lv = 0;
  for(const d of data){
    const ms = new Date(d.time).getTime();
    if(ms > atMs) continue;
    const tH = (atMs - ms) / 3600000;
    if(tH > cutoffH) continue;
    lv += pkConc(d.amountMcg, tH);
  }
  return lv;
}
function currentDoseEquivMcg(){ return doseEquivAtMs(nowMs()); }
// occupancy (%) right now — kept for zone labels / clinical reference lines,
// no longer the headline number (see disclaimers: precision drops at low dose).
function currentOccupancy(){ return equivToOcc(currentDoseEquivMcg()); }
// 7-day trailing average of dose-equivalent (mcg), sampled once/day. Linear
// and comparable week-to-week — this is the headline dashboard metric.
function trailingAvgEquiv(atMs, days){
  days = days || 7;
  let sum = 0;
  for(let i=0;i<days;i++) sum += doseEquivAtMs(atMs - i*86400000);
  return sum/days;
}
function fmtAgo(ms){
  const mins = Math.floor((nowMs() - ms) / 60000);
  if(mins < 1)  return 'just now';
  if(mins < 60) return mins + ' min ago';
  const hrs = Math.floor(mins/60), rem = mins%60;
  if(hrs < 48)  return hrs + 'h ' + rem + 'm ago';
  return Math.floor(hrs/24) + ' days ago';
}
function updateNowBlock(){
  const lvEl = document.getElementById('nowLevel'); if(!lvEl) return;
  const now = nowMs();
  const eq  = doseEquivAtMs(now); // current on-board level — the one number shown

  if(pkModifierOn){
    const hi = eq*(1+PK_VAR_SD), lo = eq*(1-PK_VAR_SD);
    lvEl.textContent = fmtAmt(lo) + '–' + fmtAmt(hi);
  } else {
    lvEl.textContent = fmtAmt(eq);
  }

  const data = getData();   // sorted newest-first
  if(data.length){
    const last = data[0];
    const dt = new Date(last.time);
    document.getElementById('nowLastDose').textContent = fmtAmt(last.amountMcg);
    document.getElementById('nowLastDoseTime').textContent =
      dt.toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) + ' · ' + fmtAgo(dt.getTime());
  } else {
    document.getElementById('nowLastDose').textContent = '—';
    document.getElementById('nowLastDoseTime').textContent = 'no doses logged yet';
  }

  const n = new Date(nowMs());
  document.getElementById('nowDate').textContent = n.toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
  const nowCap = document.getElementById('nowDateTimeCap');
  document.getElementById('nowTime').textContent = n.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  if(nowCap) nowCap.textContent = 'date & time now';

  // ── today's running total ────────────────────────────────────────────────
  const tEl = document.getElementById('nowTodayTotal');
  const cEl = document.getElementById('nowTodayCount');
  if(tEl){
    const startOfDay = new Date(n.getFullYear(), n.getMonth(), n.getDate()).getTime();
    const today = loadData().filter(r=>{
      const ms = new Date(r.time).getTime();
      return ms >= startOfDay && ms <= nowMs();
    });
    const total = today.reduce((a,r)=>a + (r.amountMcg||0), 0);
    tEl.textContent = today.length ? fmtAmt(total) : '—';
    if(cEl) cEl.textContent = today.length
      ? today.length + (today.length===1?' dose today':' doses today')
      : 'nothing logged today';
  }
}

// ─── clinician monthly average dose ────────────────────────────────────────────
function renderAvgDoses(){
  const wrap = document.getElementById('avgDoseWrap'); if(!wrap) return;
  const data = loadData();
  if(!data.length){
    wrap.innerHTML = '<div style="font-size:11px;color:var(--text3);padding:8px 0">No dose history on this device yet.</div>';
    return;
  }
  const byMonth = {};
  data.forEach(d=>{
    const dt = new Date(d.time);
    if(isNaN(dt)) return;
    const key = dt.getFullYear() + '-' + String(dt.getMonth()+1).padStart(2,'0');
    if(!byMonth[key]) byMonth[key] = {total:0, count:0, days:new Set(), y:dt.getFullYear(), m:dt.getMonth()};
    byMonth[key].total += d.amountMcg;
    byMonth[key].count++;
    byMonth[key].days.add(dt.getDate());
  });
  const keys = Object.keys(byMonth).sort().reverse();
  const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  let rows = '';
  keys.forEach(k=>{
    const b = byMonth[k];
    const nDays = b.days.size;
    const avgDaily = b.total / nDays;
    const avgPerDose = b.total / b.count;
    rows += `<tr>
      <td class="avg-month">${MON[b.m]} ${b.y}</td>
      <td class="avg-val">${fmtAmt(avgDaily)}/day</td>
      <td class="avg-val">${fmtAmt(avgPerDose)}/dose</td>
      <td class="avg-n">${b.count} doses · ${nDays} d</td>
    </tr>`;
  });
  wrap.innerHTML = `<table class="avg-table">
    <thead><tr><th>month</th><th style="text-align:right">avg daily total</th><th style="text-align:right">avg per dose</th><th style="text-align:right">recorded</th></tr></thead>
    <tbody>${rows}</tbody></table>`;
}

// ─── simulator ────────────────────────────────────────────────────────────────
// The simulator is continuous with the dashboard chart. It draws the REAL last
// three weeks from the dose log (identical model to renderPkChart), then draws a
// projection to the right of "now": the drug already on board keeps decaying and
// the user's planned schedule is layered on top.
//
// The schedule is a list of slots — each slot is one dose, at one clock time,
// with its own amount — repeating every N days. That handles QD/BID/TID/QID
// (N=1, 1–4 slots), QOD (N=2, 1 slot), and asymmetric splits like 750 mcg at
// 08:00 + 250 mcg at 20:00, which the old single-dose/single-interval model
// could not express at all.
let simChart=null;
let simUnit='mcg';       // display unit only — all internal math is in mcg
let simHorizonDays=14;   // how far right of "now" we project (max 30)
let simYMode='eq';       // 'eq' = mcg-equivalent (default) · 'occ' = occupancy zone
let simHistoryDays=30;   // days of real history to show, or the string 'all'
const SIM_HISTORY_OPTIONS=[3,7,14,30,60,100,200,'all'];
const SIM_HORIZON_MAX=30;

// schedule: {everyN: <days>, slots:[{h,m,mcg}, ...]}
let simSched={everyN:1, slots:[{h:8,m:0,mcg:750}]};

const SIM_PRESETS={
  QD : {everyN:1, times:[[8,0]]},
  BID: {everyN:1, times:[[8,0],[20,0]]},
  TID: {everyN:1, times:[[8,0],[14,0],[22,0]]},
  QID: {everyN:1, times:[[6,0],[12,0],[18,0],[0,0]]},
  QOD: {everyN:2, times:[[8,0]]}
};

// ── persistence ───────────────────────────────────────────────────────────────
const SIM_STATE_KEY='smackTracker_simState';
function saveSimState(){
  try{
    localStorage.setItem(SIM_STATE_KEY, JSON.stringify({
      sched:   simSched,
      ceiling: parseFloat(document.getElementById('ceiling').value),
      horizon: simHorizonDays,
      history: simHistoryDays,
      yMode:   simYMode,
      unit:    simUnit
    }));
  }catch(e){}
}
function restoreSimState(){
  try{
    const raw=localStorage.getItem(SIM_STATE_KEY);
    if(raw){
      const st=JSON.parse(raw);
      if(st.sched && Array.isArray(st.sched.slots) && st.sched.slots.length){
        simSched={
          everyN: clampEveryN(st.sched.everyN),
          slots: st.sched.slots
            .map(s=>({h:clampHour(s.h), m:clampMin(s.m), mcg:Math.max(0,parseFloat(s.mcg)||0)}))
            .slice(0,12)
        };
      }
      if(typeof st.ceiling==='number'){
        const el=document.getElementById('ceiling'); if(el) el.value=st.ceiling;
      }
      if(typeof st.horizon==='number') simHorizonDays=Math.min(SIM_HORIZON_MAX, st.horizon);
      if(st.history==='all' || SIM_HISTORY_OPTIONS.indexOf(st.history)!==-1) simHistoryDays=st.history;
      if(st.yMode==='occ'||st.yMode==='eq') simYMode=st.yMode;
      if(st.unit==='mcg'||st.unit==='mg')   simUnit=st.unit;
    }
  }catch(e){}
  try{
    const u=localStorage.getItem('st_unit');
    if(u==='mcg'||u==='mg') simUnit=u;
  }catch(e){}
}

// ── small helpers ─────────────────────────────────────────────────────────────
function clampHour(h){ h=parseInt(h); return isNaN(h)?0:Math.min(23,Math.max(0,h)); }
function clampMin(m){  m=parseInt(m); return isNaN(m)?0:Math.min(59,Math.max(0,m)); }
function clampEveryN(n){ n=parseInt(n); return isNaN(n)?1:Math.min(14,Math.max(1,n)); }
function fmtHM(h){const hrs=Math.floor(h),mins=Math.round((h-hrs)*60);return mins===0?hrs+'h 0m':hrs+'h '+mins+'m';}
function fmtAmt(mcg){
  if(simUnit==='mg'){
    const mg=mcg/1000;
    return (Math.round(mg*1000)/1000).toLocaleString(undefined,{maximumFractionDigits:3})+' mg';
  }
  return Math.round(mcg).toLocaleString()+' mcg';
}
function pad2(n){ return String(n).padStart(2,'0'); }

// Rough label so a row reads like a human schedule rather than a raw timestamp.
function slotTag(h){
  if(h<5)  return 'night';
  if(h<11) return 'morning';
  if(h<15) return 'midday';
  if(h<19) return 'evening';
  return 'night';
}

// Amounts are stored in mcg. The input shows whatever unit is selected.
function amtToInput(mcg){
  if(simUnit==='mg') return Math.round((mcg/1000)*1000)/1000;
  return Math.round(mcg*10)/10;
}
function inputToAmt(v){
  const n=parseFloat(v);
  if(isNaN(n)||n<0) return 0;
  return simUnit==='mg' ? n*1000 : n;
}

// ── schedule rows UI ──────────────────────────────────────────────────────────
function renderSchedRows(){
  const host=document.getElementById('schedRows');
  if(!host) return;
  if(!simSched.slots.length){
    host.innerHTML='<div class="sched-empty">No doses in this schedule. Press a preset above, or use “+ add a dose time”.</div>';
    return;
  }
  const step = simUnit==='mg' ? '0.001' : '1';
  host.innerHTML = simSched.slots.map((s,i)=>{
    const occ = equivToOcc(s.mcg);
    return '<div class="sched-row">'+
      '<span class="sched-tag">'+slotTag(s.h)+'</span>'+
      '<span class="sched-time">'+
        '<input type="number" min="0" max="23" step="1" inputmode="numeric" value="'+pad2(s.h)+'" '+
               'aria-label="hour" oninput="onSlotEdit('+i+',\'h\',this.value)" onblur="renderSchedRows()">'+
        '<span class="sched-colon">:</span>'+
        '<input type="number" min="0" max="59" step="1" inputmode="numeric" value="'+pad2(s.m)+'" '+
               'aria-label="minute" oninput="onSlotEdit('+i+',\'m\',this.value)" onblur="renderSchedRows()">'+
      '</span>'+
      '<span class="sched-amtbox">'+
        '<input type="number" min="0" step="'+step+'" inputmode="decimal" value="'+amtToInput(s.mcg)+'" '+
               'aria-label="amount" oninput="onSlotEdit('+i+',\'mcg\',this.value)">'+
        '<span class="sched-unit unit-lbl">'+simUnit+'</span>'+
      '</span>'+
      '<span class="sched-occ">'+(s.mcg>0?occZoneLabel(occ):'—')+'</span>'+
      '<button class="sched-del" onclick="removeSchedSlot('+i+')" title="remove this dose" aria-label="remove this dose">&times;</button>'+
    '</div>';
  }).join('');
}

// Live edit. We deliberately do NOT re-render the rows on every keystroke —
// that would blow away the caret while someone is typing "20". The row list is
// re-rendered on blur instead, which is when tags/occupancy need refreshing.
function onSlotEdit(i, field, val){
  const s=simSched.slots[i];
  if(!s) return;
  if(field==='h')        s.h   = clampHour(val);
  else if(field==='m')   s.m   = clampMin(val);
  else if(field==='mcg') s.mcg = inputToAmt(val);
  clearPresetHighlight();
  redrawSim();
}
function addSchedSlot(){
  // Drop the new dose in the largest gap so a 3rd row doesn't land on top of an
  // existing one.
  let h=8, m=0;
  if(simSched.slots.length){
    const mins=simSched.slots.map(s=>s.h*60+s.m).sort((a,b)=>a-b);
    const span=simSched.everyN*24*60;
    let bestGap=-1, bestAt=8*60;
    for(let i=0;i<mins.length;i++){
      const a=mins[i], b=(i+1<mins.length)?mins[i+1]:mins[0]+span;
      const gap=b-a;
      if(gap>bestGap){ bestGap=gap; bestAt=Math.round((a+gap/2))%(24*60); }
    }
    h=Math.floor(bestAt/60); m=Math.round(bestAt%60/15)*15; if(m===60){h=(h+1)%24;m=0;}
  }
  const last=simSched.slots[simSched.slots.length-1];
  simSched.slots.push({h:clampHour(h), m:clampMin(m), mcg:last?last.mcg:750});
  simSched.slots.sort((a,b)=>(a.h*60+a.m)-(b.h*60+b.m));
  clearPresetHighlight();
  renderSchedRows();
  redrawSim();
}
function removeSchedSlot(i){
  simSched.slots.splice(i,1);
  clearPresetHighlight();
  renderSchedRows();
  redrawSim();
}
function clearPresetHighlight(){
  document.querySelectorAll('#presetBar .preset-pill').forEach(p=>p.classList.remove('active'));
  syncPresetHighlight();
}
// Light the preset pill back up if the current schedule happens to match one.
function syncPresetHighlight(){
  const n=simSched.slots.length, everyN=simSched.everyN;
  let match=null;
  if(everyN===2 && n===1) match='QOD';
  else if(everyN===1){
    if(n===1) match='QD'; else if(n===2) match='BID';
    else if(n===3) match='TID'; else if(n===4) match='QID';
  }
  document.querySelectorAll('#presetBar .preset-pill').forEach(p=>{
    p.classList.toggle('active', p.dataset.preset===match);
  });
}
function applySchedPreset(key, btn){
  const p=SIM_PRESETS[key];
  if(!p) return;
  // Keep the daily total roughly where it was, split evenly across the new slots.
  const dailyTotal = simSched.slots.reduce((a,s)=>a+s.mcg,0) / Math.max(1,simSched.everyN);
  const perCycleTotal = dailyTotal * p.everyN;
  const each = p.times.length ? perCycleTotal/p.times.length : 0;
  simSched={
    everyN: p.everyN,
    slots: p.times.map(([h,m])=>({h, m, mcg: each>0?each:750}))
  };
  const nEl=document.getElementById('schedEveryN');
  if(nEl) nEl.value=simSched.everyN;
  syncEveryNLabel();
  renderSchedRows();
  syncPresetHighlight();
  redrawSim();
}
function onEveryNChange(){
  simSched.everyN = clampEveryN(document.getElementById('schedEveryN').value);
  syncEveryNLabel();
  syncPresetHighlight();
  redrawSim();
}
function normalizeEveryN(){
  document.getElementById('schedEveryN').value = simSched.everyN;
  syncEveryNLabel();
}
function syncEveryNLabel(){
  const el=document.getElementById('schedEveryNLbl');
  if(el) el.textContent = simSched.everyN===1 ? 'day' : 'days';
}

// ── projection ────────────────────────────────────────────────────────────────
// Cycle anchor: midnight of today, local time. Slot k of cycle c fires at
// anchor + c*everyN days + slot time. We only emit doses strictly after "now".
function plannedDoseTimes(fromMs, toMs){
  const out=[];
  if(!simSched.slots.length) return out;
  const n=new Date(fromMs);
  const anchor=new Date(n.getFullYear(), n.getMonth(), n.getDate()).getTime();
  const cycleMs=simSched.everyN*86400000;
  // start one cycle back so a slot earlier today is handled correctly
  for(let c=-1; ; c++){
    const cycleStart=anchor + c*cycleMs;
    if(cycleStart > toMs) break;
    for(const s of simSched.slots){
      const t=cycleStart + s.h*3600000 + s.m*60000;
      if(t>fromMs && t<=toMs && s.mcg>0) out.push({ms:t, mcg:s.mcg});
    }
  }
  return out.sort((a,b)=>a.ms-b.ms);
}

// Steady state of the repeating schedule alone, computed numerically. The old
// closed-form D/(1−e^(−ke·τ)) only holds for identical doses at a fixed
// interval; with uneven splits you have to sum the actual cycle.
function schedSteadyState(){
  const slots=simSched.slots.filter(s=>s.mcg>0);
  if(!slots.length) return {peak:0, trough:0, daily:0};
  const T=simSched.everyN*24;                        // cycle length, hours
  const nCycles=Math.ceil(12*pkParams.tHalf/T)+4;    // enough history to converge
  const stepH=Math.max(0.05, T/600);
  let peak=0, trough=Infinity;
  for(let t=0; t<T; t+=stepH){
    let lv=0;
    for(const s of slots){
      const off=s.h + s.m/60;
      for(let c=0;c<=nCycles;c++){
        const dt=t - off + c*T;
        if(dt>=0) lv+=pkConc(s.mcg, dt);
      }
    }
    if(lv>peak)   peak=lv;
    if(lv<trough) trough=lv;
  }
  const cycleTotal=slots.reduce((a,s)=>a+s.mcg,0);
  return {peak, trough:(trough===Infinity?0:trough), daily:cycleTotal/simSched.everyN};
}

// The full series: real history to the left of now, projection to the right.
// The history window is user-selectable (3…200 days, or the whole log); the
// projection is always capped at 30 days.
function simHistoryStart(now, logged){
  if(simHistoryDays!=='all') return now - simHistoryDays*86400000;
  // 'all time' — reach back to the first logged dose, but always show at least
  // three days so the chart never collapses to a sliver on a fresh install.
  const stamps=logged.map(r=>new Date(r.time).getTime()).filter(ms=>!isNaN(ms));
  if(!stamps.length) return now - 30*86400000;
  return Math.min(Math.min(...stamps) - 3600000, now - 3*86400000);
}

// Step size, snapped to a sane grid so the point count stays bounded no matter
// how wide the window is. Without this, "all time" on a multi-year log would try
// to plot hundreds of thousands of points and lock the tab.
const SIM_DT_GRID=[0.1,0.25,0.5,1,2,3,6,12,24];
function simStepHours(spanH, targetPts){
  const want=spanH/targetPts;
  return SIM_DT_GRID.find(g=>g>=want) || 24;
}

function buildSimSeries(){
  const now=nowMs();
  const logged=loadData();
  const start=simHistoryStart(now, logged);
  const end=now + simHorizonDays*86400000;

  // Doses older than 10 half-lives contribute under 0.1% — ignore them entirely.
  const tailH=10*pkParams.tHalf;
  const cutoff=start - tailH*3600000;
  const past=[...logged]
    .filter(r=>{const ms=new Date(r.time).getTime(); return !isNaN(ms) && ms>=cutoff && ms<=now;})
    .sort((a,b)=>new Date(a.time)-new Date(b.time))
    .map(r=>({ms:new Date(r.time).getTime(), mcg:r.amountMcg}));

  const future=plannedDoseTimes(now, end);
  const all=past.concat(future);   // globally ascending: every past dose <= now < every future dose

  // The two legs get their OWN step. A 200-day history has to be coarse, but the
  // projection is never longer than 30 days, so it can always stay fine — and it
  // must, or a QID sawtooth aliases into nonsense at wide history settings.
  const histH=(now-start)/3600000;
  const projH=(end-now)/3600000;
  const dtHistH=simStepHours(histH, 1600);
  const dtProjH=simStepHours(projH, 1500);
  const dtHist=dtHistH*3600000, dtProj=dtProjH*3600000;

  // `lo` walks forward with the clock so we never rescan doses that have already
  // decayed away — this is what keeps 'all time' responsive. Safe because every
  // call below passes a strictly increasing timestamp.
  let lo=0;
  const levelAt=ms=>{
    while(lo<all.length && (ms-all[lo].ms)/3600000 > tailH) lo++;
    let lv=0;
    for(let j=lo;j<all.length;j++){
      const d=all[j];
      if(d.ms>ms) break;
      lv+=pkConc(d.mcg,(ms-d.ms)/3600000);
    }
    return lv;
  };

  // Two datasets sharing one x-axis: solid past, dotted future. The seam point
  // belongs to both so the line doesn't visibly break at "now".
  const times=[], hist=[], proj=[];
  for(let ms=start; ms<now; ms+=dtHist){ times.push(ms); hist.push(levelAt(ms)); proj.push(null); }
  times.push(now); hist.push(levelAt(now)); proj.push(null);
  const seam=times.length-1;
  for(let ms=now+dtProj; ms<=end; ms+=dtProj){ times.push(ms); hist.push(null); proj.push(levelAt(ms)); }
  proj[seam]=hist[seam];

  return {times, hist, proj, start, end, now, past, future, seam, dtHistH, dtProjH};
}

// ── controls ──────────────────────────────────────────────────────────────────
function setSimHorizon(days, btn){
  simHorizonDays=Math.min(SIM_HORIZON_MAX, days);
  document.querySelectorAll('#horizonBar .preset-pill').forEach(p=>{
    p.classList.toggle('active', parseInt(p.dataset.days)===simHorizonDays);
  });
  redrawSim();
}
// History window. `v` is a day count or the string 'all'.
function setSimHistory(v){
  simHistoryDays = (v==='all') ? 'all' : parseInt(v);
  document.querySelectorAll('#historyBar .preset-pill').forEach(p=>{
    const d=p.dataset.hist;
    p.classList.toggle('active', (d==='all') ? simHistoryDays==='all'
                                             : parseInt(d)===simHistoryDays);
  });
  redrawSim();
}
function setSimYMode(mode){
  simYMode=mode;
  document.getElementById('simYOcc').classList.toggle('active', mode==='occ');
  document.getElementById('simYEq').classList.toggle('active', mode==='eq');
  redrawSim();
}

// ── draw ──────────────────────────────────────────────────────────────────────
function redrawSim(){
  if(!document.getElementById('simChart')) return;
  const ceil=parseFloat(document.getElementById('ceiling').value);
  document.getElementById('ceiling-out').textContent = fmtAmt(ceil)+' · '+occZoneLabel(equivToOcc(ceil));

  saveSimState();

  const ss=schedSteadyState();
  const series=buildSimSeries();

  // ── metrics ────────────────────────────────────────────────────────────────
  const nowLevel=(()=>{
    const i=series.times.findIndex(t=>t>series.now);
    const idx=i>0?i-1:series.times.length-1;
    return series.hist[idx] ?? 0;
  })();
  document.getElementById('sim-now').textContent = fmtAmt(nowLevel);
  document.getElementById('ss-peak-occ').textContent   = ss.peak   ? (fmtAmt(ss.peak)   + ' · ' + occZoneLabel(equivToOcc(ss.peak)))   : '—';
  document.getElementById('ss-trough-occ').textContent = ss.peak   ? (fmtAmt(ss.trough) + ' · ' + occZoneLabel(equivToOcc(ss.trough))) : '—';
  document.getElementById('ss-peak').textContent   = ss.peak ? fmtAmt(ss.peak)   : '—';
  document.getElementById('ss-trough').textContent = ss.peak ? fmtAmt(ss.trough) : '—';
  document.getElementById('ss-days').textContent   = '~'+Math.ceil(5*pkParams.tHalf/24);
  document.getElementById('sim-daily').textContent = ss.daily ? fmtAmt(ss.daily) : '—';

  const vcEl=document.getElementById('vs-ceiling');
  if(!ss.peak){ vcEl.textContent='—'; vcEl.className='metric-val'; }
  else {
    const diff=ss.peak-ceil;
    if(Math.abs(diff)<50) {vcEl.textContent='at ceiling';                    vcEl.className='metric-val ok';}
    else if(diff>0)       {vcEl.textContent='+'+fmtAmt(diff)+' over';        vcEl.className='metric-val over';}
    else                  {vcEl.textContent=fmtAmt(Math.abs(diff))+' under'; vcEl.className='metric-val under';}
  }

  // schedule summary line
  document.getElementById('schedDailyTotal').textContent = ss.daily ? fmtAmt(ss.daily) : '—';
  document.getElementById('schedPerDay').textContent =
    simSched.slots.length + (simSched.everyN>1 ? ' / '+simSched.everyN+'d' : '');
  const nextDose=series.future[0];
  document.getElementById('schedFirstDose').textContent = nextDose
    ? new Date(nextDose.ms).toLocaleString('en-US',{weekday:'short',hour:'2-digit',minute:'2-digit'})+' · '+fmtAmt(nextDose.mcg)
    : '—';

  // ── y-axis transform ───────────────────────────────────────────────────────
  const toY = v => (v===null||v===undefined) ? null
    : (simYMode==='occ' ? parseFloat(equivToOcc(v).toFixed(OCC_DP)) : parseFloat(v.toFixed(1)));
  const ceilY = simYMode==='occ' ? equivToOcc(ceil) : ceil;

  const c=chartColors();
  const histY=series.hist.map(toY), projY=series.proj.map(toY);

  const plotted=histY.concat(projY).filter(v=>typeof v==='number');
  let yMax;
  if(simYMode==='occ'){
    const dataMax=plotted.length?Math.max(...plotted, ceilY):100;
    yMax = dataMax<55 ? Math.min(100, Math.ceil((dataMax+8)/10)*10) : 100;
  } else {
    const dataMax=plotted.length?Math.max(...plotted, ceilY):ceilY;
    yMax = Math.ceil((dataMax*1.12)/100)*100;
  }

  // x tick labels — widen the format as the window grows
  const spanH=(series.end-series.start)/3600000;
  const fmtLabel=ms=>{
    const d=new Date(ms);
    if(spanH<=96)   return (d.getMonth()+1)+'/'+d.getDate()+' '+d.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
    if(spanH<=2160) return (d.getMonth()+1)+'/'+d.getDate();
    return (d.getMonth()+1)+'/'+d.getDate()+'/'+String(d.getFullYear()).slice(2);
  };
  const maxTicks=14;
  const step=Math.max(1, Math.ceil(series.times.length/maxTicks));
  const labels=series.times.map((ms,i)=>i%step===0?fmtLabel(ms):'');

  if(simChart){simChart.destroy();simChart=null;}
  simChart=new Chart(document.getElementById('simChart'),{
    type:'line',
    data:{labels, datasets:[
      { label:'logged',    data:histY, borderColor:c.line, backgroundColor:c.fill,
        borderWidth:1.5, pointRadius:0, fill:true,  tension:0, spanGaps:false },
      { label:'projected', data:projY, borderColor:c.line, backgroundColor:c.fill,
        borderWidth:1.5, borderDash:[3,3], pointRadius:0, fill:true, tension:0, spanGaps:false }
    ]},
    options:{
      responsive:true, maintainAspectRatio:false, animation:false,
      interaction:{mode:'index', intersect:false},
      plugins:{
        legend:{display:false},
        tooltip:{mode:'index', intersect:false, callbacks:{
          title:ctx=>new Date(series.times[ctx[0].dataIndex]).toLocaleString('en-US',
            {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}),
          label:ctx=>{
            if(ctx.parsed.y===null) return null;
            const i=ctx.dataIndex;
            const eq=(series.hist[i]!==null?series.hist[i]:series.proj[i])||0;
            return fmtAmt(eq);
          }
        }}
      },
      scales:{
        x:{type:'category', ticks:{color:c.tick, font:{size:9,family:'Courier New'},
           maxRotation:45, autoSkip:true, maxTicksLimit:14}, grid:{color:c.grid}},
        y:{min:0, max:yMax, grid:{color:c.grid},
           ticks:{color:c.tick, font:{size:10,family:'Courier New'},
                  callback:v=>simYMode==='occ'?v+'%':v.toLocaleString()},
           title:{display:true, color:c.tick, font:{size:9,family:'Courier New'},
                  text: simYMode==='occ' ? 'est. μ-opioid receptor occupancy' : 'blood level (mcg-equivalent)'}}
      }
    },
    plugins:[{id:'simRefs', afterDraw(ch){
      const ctx=ch.ctx, yA=ch.scales.y, xA=ch.scales.x;

      // jump-off zone + support-assisted-stop zone shading, mirroring dashboard
      const shade=(hiEq,loEq,fill,alpha)=>{
        const hv = simYMode==='occ' ? equivToOcc(hiEq) : hiEq;
        const lv = simYMode==='occ' ? equivToOcc(loEq) : loEq;
        if(!isFinite(hv)||!isFinite(lv)) return null;
        const yHi=yA.getPixelForValue(Math.min(yA.max,hv));
        const yLo=yA.getPixelForValue(Math.max(yA.min,lv));
        if(yLo>yHi){
          ctx.save(); ctx.fillStyle=fill; ctx.globalAlpha=alpha;
          ctx.fillRect(xA.left,yHi,xA.right-xA.left,yLo-yHi);
          ctx.globalAlpha=1; ctx.restore();
          return {yHi,yLo};
        }
        return null;
      };
      const jump=shade(JUMP_ZONE_HI_MCG,JUMP_ZONE_LO_MCG,c.blueDark,0.28);
      if(jump){
        ctx.save(); ctx.fillStyle=c.blueDark; ctx.font='bold 9px Courier New';
        ctx.fillText('statistical jump-off zone', xA.left+4, jump.yLo+11);
        ctx.restore();
      }
      const supp=shade(SUPPORT_ZONE_HI_MCG,SUPPORT_ZONE_LO_MCG,c.blueLight,0.14);
      if(supp){
        ctx.save(); ctx.fillStyle=c.blueLight; ctx.font='bold 9px Courier New';
        ctx.fillText('support-assisted stop range', xA.left+4, supp.yHi-3);
        ctx.restore();
      }

      // ── the "now" divider ───────────────────────────────────────────────────
      const nowIdx=series.times.findIndex(t=>t>series.now);
      if(nowIdx>0){
        const xN=xA.getPixelForValue(nowIdx-1);
        ctx.save();
        // dim the projected half so past vs future reads at a glance
        ctx.fillStyle=c.tick; ctx.globalAlpha=0.06;
        ctx.fillRect(xN, yA.top, xA.right-xN, yA.bottom-yA.top);
        ctx.globalAlpha=1;
        ctx.strokeStyle=c.line; ctx.lineWidth=1.5; ctx.setLineDash([6,3]);
        ctx.beginPath(); ctx.moveTo(xN,yA.top); ctx.lineTo(xN,yA.bottom); ctx.stroke();
        ctx.setLineDash([]);
        // Both labels sit INSIDE the plot area. Drawing above yA.top clips
        // against the canvas edge on short chart heights.
        ctx.font='bold 9px Courier New';
        ctx.fillStyle=c.line;
        ctx.textAlign='right';
        ctx.fillText('now', xN-4, yA.top+11);
        ctx.textAlign='left';
        ctx.fillStyle=c.tick; ctx.font='9px Courier New';
        ctx.fillText('projected', xN+5, yA.top+11);
        ctx.textAlign='left';
        ctx.restore();
      }

      // ── ceiling ─────────────────────────────────────────────────────────────
      if(ceilY<=yA.max && ceilY>=yA.min){
        const yC=yA.getPixelForValue(ceilY);
        ctx.save();
        ctx.strokeStyle=c.red; ctx.lineWidth=1.5;
        ctx.beginPath(); ctx.moveTo(xA.left,yC); ctx.lineTo(xA.right,yC); ctx.stroke();
        ctx.fillStyle=c.red; ctx.font='10px Courier New'; ctx.textAlign='right';
        ctx.fillText('ceiling '+fmtAmt(ceil), xA.right-6, yC-4);
        ctx.textAlign='left'; ctx.restore();
      }
    }}]
  });

  const note=document.getElementById('simAxisNote');
  if(note){
    const spanDays=(series.now-series.start)/86400000;
    const histLbl = simHistoryDays==='all'
      ? 'all time (' + (spanDays>=365 ? (spanDays/365).toFixed(1)+' yr' : Math.round(spanDays)+' days') + ')'
      : 'last ' + simHistoryDays + ' days';
    note.textContent = histLbl+' logged · '+simHorizonDays+' days projected on the schedule above';
  }
}
