// ─── PK sharktooth chart ──────────────────────────────────────────────────────
// Buprenorphine PK constants (fixed)
// t½ = 37hr  (effective terminal t½, chronic dosing)
// Absorption is a dual-pathway model (see v2.0 block below); tmax is derived.
// ke = ln(2)/t½    (first-order elimination rate constant)
// Units: mcg-accumulated (dose-equivalent)
// 750 mcg q24h SS peak/trough depend on t½ only, not on the absorption shape.

// ── v2.0 SUBLINGUAL ABSORPTION MODEL ────────────────────────────────────────
// The v1.x model used a single first-order absorption constant with tmax pinned
// to 2 hr. That produced a curve that was far too fast early — ~47% of peak at
// 15 min and effectively topped out by 90 min — which does not match how SL
// buprenorphine films actually behave.
//
// Physiology (Kalluri 2017 PBPK; Sublocade/CAM2038 popPK): a sublingual film is
// NOT one absorption process. The dose splits across:
//   (1) rapid passive absorption across the sublingual mucosa (minutes),
//   (2) a slow release from the buccal tissue depot,
//   (3) GI absorption of the swallowed fraction (the majority of the dose).
// Published popPK models describe SL bup with DUAL PARALLEL first-order
// absorption for exactly this reason. Kalluri's split is ~62.5% non-depot
// (of which most is swallowed/GI) and ~37.5% buccal depot.
//
// So v2.0 uses two parallel first-order inputs into the same central compartment:
//   fast  — mucosal/sublingual, ka_fast, the sharp early rise
//   slow  — swallowed GI + buccal depot, ka_slow, the long creep to peak
//
// C(t) = F·[ka_f/(ka_f-ke)]·(e^-ke·t − e^-ka_f·t)
//      + (1−F)·[ka_s/(ka_s-ke)]·(e^-ke·t − e^-ka_s·t)
// normalized so the peak equals the dose amount (dose-equivalent units), which
// keeps every downstream number (accumulation, SS, occupancy) on the same scale
// as before. Only the SHAPE of the ramp changed, not the dose bookkeeping.
//
// Resulting profile (t½=36hr), % of that dose's own peak:
//   15min 33% · 30min 54% · 45min 67% · 60min 76% · 90min 87% · 2hr 93%
//   3hr 99% · 4hr 100% (tmax) · 6hr 98%
// Sharp early rise, ~87% by 90 min, ~93% by 2 hr, then a slow creep to a flat
// peak around 4 hr — the shape reported for SL film, and the shape users see.
//
// Tmax note: single-timepoint "median Tmax" values in the literature cluster
// at 1–3.5 hr (FDA reviews: 1.25 hr median, range 0.33–3.0; Puerto Rico OUD
// cohort: 1.5 ± 0.7 hr; high-dose SL tablets: 0.5–3 hr). Those medians are
// pulled early by sparse sampling and by the near-flat top of the curve — once
// a curve is at 93% by 2 hr, whether the recorded max lands at 2 hr or 4 hr is
// close to a coin flip between adjacent draws. The model's flat 3–4.5 hr peak
// is consistent with that spread rather than contradicting it.
const PK_F_FAST  = 0.42;   // fraction via fast mucosal route
const PK_KA_FAST = 2.60;   // /hr — mucosal (absorption t½ ≈ 16 min)
const PK_KA_SLOW = 0.80;   // /hr — swallowed GI + buccal depot (t½ ≈ 52 min)

// Half-life is user-selectable (24 / 30 / 36 / 42 hr) but DEFAULTS to 36 hr.
// Reported terminal t½ for SL bup spans roughly 22–44 hr between studies and
// between people, so the selector spans that range. 36 hr stays the default.
const PK_THALF_OPTIONS = [24, 30, 36, 42];
const PK_THALF_KEY = 'st_pk_thalf';

const pkParams = {
  tHalf: 36,   // hours — default; user-adjustable via the selector
};

// Restore a saved half-life choice, if any.
(function(){
  try{
    const v = parseFloat(localStorage.getItem(PK_THALF_KEY));
    if(PK_THALF_OPTIONS.indexOf(v) !== -1) pkParams.tHalf = v;
  }catch(e){}
})();

function getPkKe(){ return Math.log(2) / pkParams.tHalf; }

// One first-order absorption term, normalized to unit input.
function pkTerm(ka, ke, t){
  if(Math.abs(ka - ke) < 1e-9) return ke * t * Math.exp(-ke * t);
  return (ka / (ka - ke)) * (Math.exp(-ke * t) - Math.exp(-ka * t));
}

// Un-normalized dual-pathway shape at time t.
function pkShapeRaw(t, ke){
  return PK_F_FAST        * pkTerm(PK_KA_FAST, ke, t)
       + (1 - PK_F_FAST)  * pkTerm(PK_KA_SLOW, ke, t);
}

// Peak height + tmax of the shape, cached per half-life (the scan is only
// re-run when the user changes t½).
let _pkNormCache = {};
function getPkNorm(){
  const key = pkParams.tHalf;
  if(_pkNormCache[key]) return _pkNormCache[key];
  const ke = getPkKe();
  let tmax = 0, peak = 0;
  for(let t = 0.005; t < 16; t += 0.002){
    const v = pkShapeRaw(t, ke);
    if(v > peak){ peak = v; tmax = t; }
  }
  return (_pkNormCache[key] = { peak, tmax, ke });
}

// Actual time-to-peak of the current curve (hours).
function getPkTmax(){ return getPkNorm().tmax; }

// Single-dose concentration at t hours post-dose — used everywhere
// (dashboard, simulator, sharktooth chart). Peaks at exactly doseAmtMcg.
function pkConc(doseAmtMcg, tHours){
  if(tHours < 0) return 0;
  const n = getPkNorm();
  return doseAmtMcg * pkShapeRaw(tHours, n.ke) / n.peak;
}

// Fraction of this dose's own peak reached at t hours — drives the
// absorption timeline readout.
function pkFractionOfPeak(tHours){
  if(tHours <= 0) return 0;
  const n = getPkNorm();
  return pkShapeRaw(tHours, n.ke) / n.peak;
}

// Change the half-life and rebuild everything that depends on it.
function setPkHalfLife(h){
  h = parseFloat(h);
  if(PK_THALF_OPTIONS.indexOf(h) === -1) return;
  pkParams.tHalf = h;
  _pkNormCache = {};
  try{ localStorage.setItem(PK_THALF_KEY, String(h)); }catch(e){}
  syncPkHalfLifeUI();
  updatePkFooter();
  if(typeof rebuildPkChart === 'function') rebuildPkChart();
  if(typeof renderAvgDoses === 'function') renderAvgDoses();
  if(typeof updateNowBlock === 'function'){ try{ updateNowBlock(); }catch(e){} }
  if(typeof redrawSim === 'function') redrawSim();
  renderAbsorptionTimeline();
}

function syncPkHalfLifeUI(){
  const wrap = document.getElementById('pkHalfLifeSel');
  if(wrap){
    wrap.querySelectorAll('button').forEach(b=>{
      b.classList.toggle('active', parseFloat(b.dataset.h) === pkParams.tHalf);
    });
  }
  const lbl = document.getElementById('pkHalfLifeLabel');
  if(lbl) lbl.innerHTML = 'half-life <b>' + pkParams.tHalf + ' hr</b>';
  const tp = document.getElementById('pkTpeakLabel');
