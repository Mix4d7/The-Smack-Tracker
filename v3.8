  <!-- ═══════════════ FINAL / DISCLAIMERS ═══════════════ -->
  <div id="panel-final" class="panel">

    <div id="gateBox" class="gate-box" style="display:none">
      <div class="gate-title">Before you use The Smack Tracker</div>
      <div class="gate-text">This is a self-tracking tool, not medical guidance. Read the disclaimers below, then check the box to continue.</div>
      <label class="gate-check-row">
        <input type="checkbox" id="gateAckCheck" onchange="onGateAckChange()">
        <span>I have read this, I am responsible for my own decisions and I am under the care of a licensed physician. The Smack Tracker is a tool for me to use — not a source of guidance for use of medications.</span>
      </label>
      <label class="gate-check-row">
        <input type="checkbox" id="gateNeverShow">
