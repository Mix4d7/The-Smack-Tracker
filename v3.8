let curLang = localStorage.getItem('st_lang') || 'en';
function t(key){ return (LANG[curLang] && LANG[curLang][key]) || LANG.en[key] || key; }
function langDef(code){ return LANGS.find(l=>l.code===code) || LANGS[0]; }
function applyLang(){
  const def = langDef(curLang);
