const STORE_KEY='smackTrackerData_v2';
const SEED_MERGE_FLAG='smackTracker_seedMerged_v105';
// One-time, non-destructive merge of the embedded history (SEED) into stored data.
// Adds only entries not already present (dedup by minute + dose), then sets a flag so
// it never runs again — meaning edits and deletions you make afterward always stick.
function loadData(){
  let cur=[];
  try{const r=localStorage.getItem(STORE_KEY);if(r){const p=JSON.parse(r);if(Array.isArray(p))cur=p;}}catch(e){}
  try{
    if(SEED.length && localStorage.getItem(SEED_MERGE_FLAG)!=='1'){
      const present=new Set(cur.map(e=>e.time+'|'+Math.round(e.amountMcg)));
      let added=false;
      for(const s of SEED){const k=s.time+'|'+Math.round(s.amountMcg);if(!present.has(k)){cur.push(Object.assign({},s));present.add(k);added=true;}}
      if(added) saveData(cur);
      localStorage.setItem(SEED_MERGE_FLAG,'1');
    }
  }catch(e){}
  return cur.slice();
}
function saveData(d){localStorage.setItem(STORE_KEY,JSON.stringify(d));}
function getData(){return loadData().sort((a,b)=>new Date(b.time)-new Date(a.time));}
function isDup(e,d){return d.some(x=>x.time===e.time&&Math.round(x.amountMcg)===Math.round(e.amountMcg));}

