      { n: 80, cols: 10, rows: 8, desc: '150 mcg per piece' },
    ]
  }
};

let activeFilm = '2mg';

function selectFilm(key, btn) {
  activeFilm = key;
  document.querySelectorAll('#filmSelector .range-pill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderCutGuide();
}

// Build an SVG film diagram at true mm dimensions.
// SVG uses mm units natively — browsers honour this at 100% print scale.
// Each division is shown as a 2D grid (cols × rows) chosen for near-square cells.
// Films are laid out in a vertical column, one per division, with labels to the right.
function buildFilmSVG(filmKey) {
  const film = FILMS[filmKey];
  const { w, h, totalMcg, divisions } = film;

  const labelW  = 56;   // mm for right-side text
  const rowGap  = 5;    // mm between successive film diagrams
  const topPad  = 7;    // mm before first film
  const leftPad = 8;    // mm left of film (for height annotation)

  const totalDivs = divisions.length;
  const svgH = topPad + totalDivs * h + (totalDivs - 1) * rowGap + 6;
  const svgW = leftPad + w + 4 + labelW;

  // colours — work in both light and dark mode since SVG is embedded
  const filmFill  = '#f0a04a';      // warm orange, legible in both modes
  const lineCol   = '#5a2800';      // dark brown grid lines
  const textMain  = darkMode ? '#d8d8c8' : '#1a1a14';
  const textDim   = darkMode ? '#7a7a70' : '#7a7a68';
  const bgFill    = darkMode ? '#141414' : '#faf9f4';

  let svg = '';

  // ── top dimension callout (width) ──
  const annY = topPad - 2;
  const tk = 1.0; // tick half-height
  svg += `<line x1="${leftPad}" y1="${annY}" x2="${leftPad+w}" y2="${annY}" stroke="${textDim}" stroke-width="0.2"/>`;
  svg += `<line x1="${leftPad}"   y1="${annY-tk}" x2="${leftPad}"   y2="${annY+tk}" stroke="${textDim}" stroke-width="0.2"/>`;
  svg += `<line x1="${leftPad+w}" y1="${annY-tk}" x2="${leftPad+w}" y2="${annY+tk}" stroke="${textDim}" stroke-width="0.2"/>`;
  svg += `<text x="${leftPad+w/2}" y="${annY-0.6}" text-anchor="middle" font-family="Courier New,monospace" font-size="2.5" fill="${textDim}">${w} mm</text>`;

  divisions.forEach((div, i) => {
    const { cols, rows, n, desc } = div;
    const cellW = w / cols;
    const cellH = h / rows;
    const fx = leftPad;
    const fy = topPad + i * (h + rowGap);

    // ── left height annotation (first diagram only) ──
    if (i === 0) {
      svg += `<line x1="${fx-1.5}" y1="${fy}" x2="${fx-1.5}" y2="${fy+h}" stroke="${textDim}" stroke-width="0.2"/>`;
      svg += `<line x1="${fx-2.5}" y1="${fy}"   x2="${fx-0.5}" y2="${fy}"   stroke="${textDim}" stroke-width="0.2"/>`;
      svg += `<line x1="${fx-2.5}" y1="${fy+h}" x2="${fx-0.5}" y2="${fy+h}" stroke="${textDim}" stroke-width="0.2"/>`;
      svg += `<text x="${fx-1.5}" y="${fy+h/2}" text-anchor="middle" dominant-baseline="middle" font-family="Courier New,monospace" font-size="2.3" fill="${textDim}" transform="rotate(-90,${fx-1.5},${fy+h/2})">${h} mm</text>`;
    }

    // ── film background ──
    svg += `<rect x="${fx}" y="${fy}" width="${w}" height="${h}" fill="${filmFill}" stroke="${lineCol}" stroke-width="0.35" rx="0.4"/>`;

    // ── vertical cut lines (cols-1) ──
    for (let c = 1; c < cols; c++) {
      const lx = fx + c * cellW;
      svg += `<line x1="${lx}" y1="${fy}" x2="${lx}" y2="${fy+h}" stroke="${lineCol}" stroke-width="0.25"/>`;
    }

    // ── horizontal cut lines (rows-1) ──
    for (let r = 1; r < rows; r++) {
      const ly = fy + r * cellH;
      svg += `<line x1="${fx}" y1="${ly}" x2="${fx+w}" y2="${ly}" stroke="${lineCol}" stroke-width="0.25"/>`;
    }

    // ── right-side label ──
    const lx = fx + w + 4;
    const ly = fy + h / 2;
    const gridStr = `${cols}×${rows}`;
    const cellStr = `${cellW.toFixed(2)}×${cellH.toFixed(2)} mm`;
    svg += `<text x="${lx}" y="${ly - 2.2}" font-family="Courier New,monospace" font-size="3.4" font-weight="700" fill="${textMain}">÷${n} &nbsp; ${desc}</text>`;
    svg += `<text x="${lx}" y="${ly + 1.4}" font-family="Courier New,monospace" font-size="2.5" fill="${textDim}">grid ${gridStr} &nbsp;·&nbsp; cell ${cellStr}</text>`;
  });

  const PX = 3.7795; // mm → px at 96 dpi (screen display size)
  return `<svg xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 ${svgW} ${svgH}"
    width="${svgW * PX}px" height="${svgH * PX}px"
    style="display:block;max-width:100%;overflow:visible">
    <rect x="0" y="0" width="${svgW}" height="${svgH}" fill="${bgFill}"/>
    ${svg}
  </svg>`;
}

function renderCutGuide() {
  const film = FILMS[activeFilm];
  document.getElementById('filmInfoLine').innerHTML =
    `<span style="color:var(--text)">${film.label}</span>`
    + ` &nbsp;·&nbsp; ${film.w} × ${film.h} mm &nbsp;·&nbsp; ${film.totalMcg.toLocaleString()} mcg total`
    + `<div style="margin-top:4px;font-size:11px;color:var(--amber)">${film.note}</div>`;
  document.getElementById('cutPrintArea').innerHTML = buildFilmSVG(activeFilm);
}

function printCutGuide() {
  const film = FILMS[activeFilm];
  const svgHtml = buildFilmSVG(activeFilm);
  const el = document.getElementById('printOnly');

  el.innerHTML =
    '<h2>The Smack Tracker — Film Cut Guide</h2>'
  + '<p>' + film.label + ' · ' + film.w + '×' + film.h + ' mm · ' + film.totalMcg.toLocaleString() + ' mcg total</p>'
  + '<p class="pw">' + film.note + '</p>'
  + '<p>Print at 100% scale — no fit-to-page, no scaling. Verify 22mm width with a ruler before cutting.</p>'
  + svgHtml;

  // Let the DOM update, then print
  setTimeout(function() {
    window.print();
    setTimeout(function() { el.innerHTML = ''; }, 1000);
  }, 50);
}

