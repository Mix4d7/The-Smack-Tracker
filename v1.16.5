// ─── present occupancy + dashboard status ──────────────────────────────────────
// Uses the same 1-cpt model as the peaks & troughs chart, then the frozen
// dose-equivalent → ng/mL → occupancy chain, so every box agrees.
// Dose-equivalent (mcg) on board at an arbitrary time `atMs`.
function doseEquivAtMs(atMs){
  const data = loadData();
  const cutoffH = 12 * pkParams.tHalf;   // beyond this a dose contributes <0.03%
  let lv = 0;
  for(const d of data){
    const ms = new Date(d.time).getTime();
    if(ms > atMs) continue;
    const tH = (atMs - ms) / 3600000;
    if(tH > cutoffH) continue;
    lv += pkConc(d.amountMcg, tH);
  }
  return lv;
}
function currentDoseEquivMcg(){ return doseEquivAtMs(nowMs()); }
// occupancy (%) right now
function currentOccupancy(){ return equivToOcc(currentDoseEquivMcg()); }
function fmtAgo(ms){
  const mins = Math.floor((nowMs() - ms) / 60000);
  if(mins < 1)  return 'just now';
  if(mins < 60) return mins + ' min ago';
  const hrs = Math.floor(mins/60), rem = mins%60;
  if(hrs < 48)  return hrs + 'h ' + rem + 'm ago';
  return Math.floor(hrs/24) + ' days ago';
}
function updateNowBlock(){
  const lvEl = document.getElementById('nowLevel'); if(!lvEl) return;
  const now = nowMs();
  const eq  = doseEquivAtMs(now);
  const occ = equivToOcc(eq);
  const ng  = equivToNgml(eq);

  const equivEl = document.getElementById('nowLevelEquiv');
  if(pkModifierOn){
    const hiOcc = equivToOcc(eq*(1+PK_VAR_SD));
    const loOcc = equivToOcc(eq*(1-PK_VAR_SD));
    lvEl.textContent = Math.round(loOcc) + '–' + Math.round(hiOcc) + '%';
    if(equivEl) equivEl.textContent = fmtAmt(eq) + '-equiv';
    document.getElementById('nowLevelSub').textContent =
      'est. μ-opioid receptor occupancy · ±1 SD band (typical ' + Math.round(occ) + '%, ~' + ng.toFixed(2) + ' ng/mL)';
  } else {
    lvEl.textContent = Math.round(occ) + '%';
    if(equivEl) equivEl.textContent = fmtAmt(eq) + '-equiv';
    document.getElementById('nowLevelSub').textContent =
      'est. μ-opioid receptor occupancy · ~' + ng.toFixed(2) + ' ng/mL on board';
  }

  // Week-over-week rate: occupancy now vs. same clock-time 7 days ago.
  const rateEl = document.getElementById('nowRate');
  if(rateEl){
    const occWeekAgo = equivToOcc(doseEquivAtMs(now - 7*86400000));
    const delta = occ - occWeekAgo;
    const arrow = delta > 0.5 ? '▲' : (delta < -0.5 ? '▼' : '▬');
    const sign  = delta > 0 ? '+' : '';
    rateEl.textContent = arrow + ' ' + sign + delta.toFixed(1) + ' pts vs 7 days ago';
    rateEl.style.color = delta < -0.5 ? 'var(--blue)' : (delta > 0.5 ? 'var(--amber)' : 'var(--text3)');
  }

  // Taper-endpoint context: tell people where they are relative to the jump-off
  // zone so very low numbers stay meaningful and no one chases zero.
  const jumpEl = document.getElementById('nowJump');
  if(jumpEl){
    if(occ <= OCC_JUMP_HI + 0.5){
      jumpEl.textContent = '● in the typical jump-off zone — most people discontinue around here (with clinician support), not by cutting further';
      jumpEl.style.color = 'var(--accent)';
    } else if(occ <= OCC_TWO_MG_WALL + 1){
      const toJump = Math.max(0, occ - OCC_JUMP_HI);
      jumpEl.textContent = '● below the 2 mg wall · ~' + toJump.toFixed(0) + ' pts above the typical jump-off zone (~8–15%)';
      jumpEl.style.color = 'var(--text2)';
    } else {
      jumpEl.textContent = '\u00A0';
      jumpEl.style.color = 'var(--text3)';
    }
  }

  const data = getData();   // sorted newest-first
  if(data.length){
    const last = data[0];
    const dt = new Date(last.time);
    document.getElementById('nowLastDose').textContent = fmtAmt(last.amountMcg);
    document.getElementById('nowLastDoseTime').textContent =
      dt.toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) + ' · ' + fmtAgo(dt.getTime());
  } else {
    document.getElementById('nowLastDose').textContent = '—';
    document.getElementById('nowLastDoseTime').textContent = 'no doses logged yet';
  }

  const n = new Date(nowMs());
  document.getElementById('nowDate').textContent = n.toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
  const nowCap = document.querySelector('#nowBlock .now-cell:last-child .now-cap');
  if(tmActive()){
    document.getElementById('nowTime').textContent = n.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}) + ' · projected';
    if(nowCap) nowCap.textContent = 'projected date & time';
  } else {
    document.getElementById('nowTime').textContent = n.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    if(nowCap) nowCap.textContent = 'date & time now';
  }
}

// ─── clinician monthly average dose ────────────────────────────────────────────
function renderAvgDoses(){
  const wrap = document.getElementById('avgDoseWrap'); if(!wrap) return;
  const data = loadData();
  if(!data.length){
    wrap.innerHTML = '<div style="font-size:11px;color:var(--text3);padding:8px 0">No dose history on this device yet.</div>';
    return;
  }
  const byMonth = {};
  data.forEach(d=>{
    const dt = new Date(d.time);
    if(isNaN(dt)) return;
    const key = dt.getFullYear() + '-' + String(dt.getMonth()+1).padStart(2,'0');
    if(!byMonth[key]) byMonth[key] = {total:0, count:0, days:new Set(), y:dt.getFullYear(), m:dt.getMonth()};
    byMonth[key].total += d.amountMcg;
    byMonth[key].count++;
    byMonth[key].days.add(dt.getDate());
  });
  const keys = Object.keys(byMonth).sort().reverse();
  const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  let rows = '';
  keys.forEach(k=>{
    const b = byMonth[k];
    const nDays = b.days.size;
    const avgDaily = b.total / nDays;
    const avgPerDose = b.total / b.count;
    rows += `<tr>
      <td class="avg-month">${MON[b.m]} ${b.y}</td>
      <td class="avg-val">${fmtAmt(avgDaily)}/day</td>
      <td class="avg-val">${fmtAmt(avgPerDose)}/dose</td>
      <td class="avg-n">${b.count} doses · ${nDays} d</td>
    </tr>`;
  });
  wrap.innerHTML = `<table class="avg-table">
    <thead><tr><th>month</th><th style="text-align:right">avg daily total</th><th style="text-align:right">avg per dose</th><th style="text-align:right">recorded</th></tr></thead>
    <tbody>${rows}</tbody></table>`;
}

// ─── simulator ────────────────────────────────────────────────────────────────
let simChart=null;
let simUnit='mcg';   // display unit only — all internal math is in mcg
let simTau=24;       // dosing interval in hours (source of truth)

// Persist simulator settings so the page reopens exactly where you left it.
const SIM_STATE_KEY='smackTracker_simState';
function saveSimState(){
  try{
    const st={
      dose:  parseFloat(document.getElementById('dose').value),
      tau:   simTau,
      ceiling:parseFloat(document.getElementById('ceiling').value),
      startPeak:parseFloat(document.getElementById('startPeak').value),
      unit:  simUnit
    };
    localStorage.setItem(SIM_STATE_KEY, JSON.stringify(st));
  }catch(e){}
}
function restoreSimState(){
  try{
    const raw=localStorage.getItem(SIM_STATE_KEY);
    if(!raw)return;
    const st=JSON.parse(raw);
    if(typeof st.dose==='number')      document.getElementById('dose').value=st.dose;
    if(typeof st.ceiling==='number')   document.getElementById('ceiling').value=st.ceiling;
    if(typeof st.startPeak==='number') document.getElementById('startPeak').value=st.startPeak;
    if(typeof st.tau==='number')       simTau=clampTau(st.tau);
    if(st.unit==='mcg'||st.unit==='mg')simUnit=st.unit;
  }catch(e){}
  try{
    const u=localStorage.getItem('st_unit');
    if(u==='mcg'||u==='mg')simUnit=u;
  }catch(e){}
}
function fmtHM(h){const hrs=Math.floor(h),mins=Math.round((h-hrs)*60);return mins===0?hrs+'h 0m':hrs+'h '+mins+'m';}
function fmtAmt(mcg){
  if(simUnit==='mg'){
    const mg=mcg/1000;
    return (Math.round(mg*1000)/1000).toLocaleString(undefined,{maximumFractionDigits:3})+' mg';
  }
  return Math.round(mcg).toLocaleString()+' mcg';
}

// Accumulation (instantaneous-absorption) sharktooth model.
// Each dose adds its full amount D at the dosing instant; between doses the level
// decays by first-order elimination at the given half-life: C(t)=C0·e^(−ke·t).
// At steady state the peak converges to D/(1−e^(−ke·τ)) — the standard accumulation
// ratio. This reproduces the clinical reference (750 mcg q24h, t½=37h → ~2070 mcg)
// and lets the curve begin exactly at the prior steady-state peak.
function simData(dose, tau, priorPeak){
  const totalH = 10 * 24;
  const dt = 0.05;
  const ke = getPkKe();
  const nSteps = Math.round(totalH / dt);
  const times = [], levels = [];
  for(let i = 0; i <= nSteps; i++){
    const t = i * dt;
    // residual of the prior steady state (decays from priorPeak at t=0)
    let lv = priorPeak * Math.exp(-ke * t);
    // new-schedule doses: absorption curve via pkConc, peaks at dose amount at tmax
    // (same model as dashboard currentBloodLevelMcg, so simulator is consistent)
    let k = 1;
    while(k * tau <= t + 1e-9){
      lv += pkConc(dose, t - k * tau);
      k++;
    }
    times.push(parseFloat((t / 24).toFixed(4)));
    levels.push(parseFloat(lv.toFixed(1)));
  }
  return {times, levels};
}

// tmax now equals pkParams.tPeak exactly (ka is solved so tmax = tPeak).
function calcTmax() {
  return pkParams.tPeak;
}

// Steady-state peak using the normalized model.
// Since pkConc peaks at exactly D (normalized), and the accumulation ratio
// at the peak time (tmax after last dose) converges to D / (1 - e^(-ke*tau)),
// we use the standard formula but note it now gives peak = D at tmax, not
// an inflated value. For a taper guide this is the correct interpretation:
// if you dose 750 mcg/day the SS peak will not exceed what linear accumulation
// of 750-mcg peaks would give.
function calcSsPeak(dose, tau){
  const ke = getPkKe();
  return dose / (1 - Math.exp(-ke * tau));
}

// Steady-state trough = the peak one full interval later (pure elimination).
// C_ss_trough = C_ss_peak · e^(−ke·τ).
function calcSsTrough(dose, tau){
  const ke = getPkKe();
  return calcSsPeak(dose, tau) * Math.exp(-ke * tau);
}

function redrawSim(){
  const dose = parseFloat(document.getElementById('dose').value);
  const tau  = simTau;
  const ceil = parseFloat(document.getElementById('ceiling').value);
  const sp   = parseFloat(document.getElementById('startPeak').value);

  document.getElementById('dose-out').textContent      = fmtAmt(dose) + ' · ' + Math.round(equivToOcc(dose)) + '%';
  document.getElementById('interval-out').textContent  = fmtHM(tau);
  document.getElementById('ceiling-out').textContent   = fmtAmt(ceil) + ' · ' + Math.round(equivToOcc(ceil)) + '%';
  document.getElementById('startPeak-out').textContent = fmtAmt(sp) + ' · ' + Math.round(equivToOcc(sp)) + '%';

  saveSimState();

  const ssPeak   = calcSsPeak(dose, tau);
  const ssTrough = calcSsTrough(dose, tau);

  document.getElementById('ss-peak').textContent   = fmtAmt(ssPeak);
  document.getElementById('ss-trough').textContent = fmtAmt(ssTrough);
  document.getElementById('ss-days').textContent   = '~'+Math.ceil(5 * pkParams.tHalf / 24);

  // Occupancy at SS peak / trough via the same frozen chain the dashboard uses.
  const peakOcc = equivToOcc(ssPeak), troughOcc = equivToOcc(ssTrough);
  document.getElementById('ss-peak-occ').textContent   = Math.round(peakOcc) + '%';
  document.getElementById('ss-trough-occ').textContent = Math.round(troughOcc) + '%';

  const diff = ssPeak - ceil;
  const vcEl = document.getElementById('vs-ceiling');
  if(Math.abs(diff)<50)  {vcEl.textContent='at ceiling'; vcEl.className='metric-val ok';}
  else if(diff>0)         {vcEl.textContent='+'+fmtAmt(diff)+' over'; vcEl.className='metric-val over';}
  else                    {vcEl.textContent=fmtAmt(Math.abs(diff))+' under'; vcEl.className='metric-val under';}

  // Curve begins exactly at the prior steady-state peak, then converges to the new SS
  const {times, levels} = simData(dose, tau, sp);
  const maxY = Math.max(sp, ceil, ...levels) * 1.12;
  const c = chartColors();

  if(simChart){simChart.destroy();simChart=null;}
  simChart = new Chart(document.getElementById('simChart'),{
    type:'line',
    data:{labels:times, datasets:[{data:levels, borderColor:c.line, backgroundColor:c.fill, borderWidth:1.5, pointRadius:0, fill:true, tension:0}]},
    options:{
      responsive:true, maintainAspectRatio:false, animation:{duration:80},
      plugins:{legend:{display:false}, tooltip:{callbacks:{
        label:ctx=>fmtAmt(ctx.parsed.y),
        title:ctx=>'day '+parseFloat(ctx[0].label).toFixed(2)
      }}},
      scales:{
        x:{type:'linear', min:0, max:10, ticks:{stepSize:1, callback:v=>Number.isInteger(v)?'day '+v:'', maxRotation:0, color:c.tick, font:{size:10,family:'Courier New'}}, grid:{color:c.grid}},
        y:{min:0, max:Math.ceil(maxY/100)*100, ticks:{callback:v=>v.toLocaleString(), color:c.tick, font:{size:10,family:'Courier New'}}, grid:{color:c.grid}}
      }
    },
    plugins:[{id:'rl', afterDraw(ch){
      const ctx=ch.ctx, yA=ch.scales.y, xA=ch.scales.x;
      const cv=parseFloat(document.getElementById('ceiling').value);
      const sv=parseFloat(document.getElementById('startPeak').value);

      // ── Occupancy reference shading (same idea as the dashboard) ────────────
      // The simulator's y-axis is in mcg blood-level, so we convert the occupancy
      // thresholds to their mcg-equivalents via occToEquiv() before shading.
      const shadeBand=(occHi,occLo,fillStyle,alpha)=>{
        const eqHi=occToEquiv(occHi), eqLo=occToEquiv(occLo);
        if(!isFinite(eqHi)||!isFinite(eqLo)) return null;
        const yHi=yA.getPixelForValue(Math.min(yA.max,eqHi));
        const yLo=yA.getPixelForValue(Math.max(yA.min,eqLo));
        if(yLo>yHi){
          ctx.save();
          ctx.fillStyle=fillStyle; ctx.globalAlpha=alpha;
          ctx.fillRect(xA.left,yHi,xA.right-xA.left,yLo-yHi);
          ctx.globalAlpha=1; ctx.restore();
          return {yHi,yLo};
        }
        return null;
      };
      // steep zone (15–45% occ)
      const steep=shadeBand(45,15,c.fill,0.4);
      if(steep){
        ctx.save(); ctx.fillStyle=c.tick; ctx.font='9px Courier New';
        ctx.fillText('steep zone — small dose changes move occupancy most', xA.left+4, steep.yHi-3);
        ctx.restore();
      }
      // jump-off zone (8–15% occ)
      const jump=shadeBand(OCC_JUMP_HI,OCC_JUMP_LO,c.line,0.16);
      if(jump){
        ctx.save(); ctx.fillStyle=c.line; ctx.font='bold 9px Courier New';
        ctx.fillText('typical jump-off zone (~0.25–0.5 mg) — most people stop here', xA.left+4, jump.yLo+11);
        ctx.restore();
      }

      const yC=yA.getPixelForValue(cv);
      ctx.save();
      ctx.strokeStyle=c.red; ctx.lineWidth=1.5;
      ctx.beginPath(); ctx.moveTo(xA.left,yC); ctx.lineTo(xA.right,yC); ctx.stroke();
      ctx.fillStyle=c.red; ctx.font='10px Courier New';
      ctx.fillText('ceiling '+fmtAmt(cv), xA.right-130, yC-4);
      const yS=yA.getPixelForValue(sv);
      if(yS>yA.top && yS<yA.bottom){
        ctx.strokeStyle=c.dash; ctx.lineWidth=1; ctx.setLineDash([4,4]);
        ctx.beginPath(); ctx.moveTo(xA.left,yS); ctx.lineTo(xA.right,yS); ctx.stroke();
        ctx.setLineDash([]); ctx.fillStyle=c.dash;
        ctx.fillText('prior '+fmtAmt(sv), xA.right-130, yS-4);
      }
      ctx.restore();
    }}]
  });
}
function rebuildSimChart(){if(simChart){simChart.destroy();simChart=null;}redrawSim();}

