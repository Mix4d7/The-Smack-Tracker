}
function resetDefaultsKeepData(){
  if(!confirm('Reset display settings (theme, language, units, simulator schedule) to defaults? Your dose history and instance ID are kept.')) return;
  try{
    localStorage.removeItem('st_theme');
    localStorage.removeItem('st_lang');
    localStorage.removeItem('st_unit');
    localStorage.removeItem(SIM_STATE_KEY);
    localStorage.removeItem(CLIN_SKIP_KEY);
  }catch(e){}
  location.reload();
}
function resetDefaultsEraseData(){
  const typed = prompt('This permanently erases ALL data — dose history, instance ID, and settings — and cannot be undone. Please export your JSON file first if you want a backup.\n\nType ERASE to confirm.');
  if(typed !== 'ERASE') return;
  try{ localStorage.clear(); }catch(e){}
  location.reload();
}

// ─── history table ────────────────────────────────────────────────────────────
function logDose(){
  const t=document.getElementById('logTime').value;
  const d=parseFloat(document.getElementById('logDose').value);
  const n=document.getElementById('logNotes').value.trim();
  if(!t||!d||d<=0){alert('Enter a valid time and dose.');return;}
  const data=loadData();
  data.push({time:t,amountMcg:d,drug:'bup',form:'Sublingual film',notes:n,symptoms:null});
  saveData(data); document.getElementById('logDose').value=''; document.getElementById('logNotes').value='';
  setLogTimeNow(); renderHistory(); renderPkChart();
}
function renderHistory(){
  const data=getData();
  const search=document.getElementById('histSearch').value.toLowerCase();
  const days=parseInt(document.getElementById('histDays').value);
  const cutoff=days>0?new Date(Date.now()-days*86400000):new Date(0);
  const filtered=data.filter(r=>new Date(r.time)>=cutoff&&(!search||(r.notes||'').toLowerCase().includes(search)));
  const tbody=document.getElementById('histBody');
  tbody.innerHTML='';
  filtered.forEach(r=>{
    const dt=new Date(r.time);
    const tr=document.createElement('tr');
    tr.innerHTML=`<td class="time-cell">${dt.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})} ${dt.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})}</td><td class="dose-cell">${Math.round(r.amountMcg*10)/10} mcg</td><td style="color:var(--text3);font-size:11px">${r.form||''}</td><td style="color:var(--text2)">${r.notes||''}</td><td><button class="del-btn" onclick="deleteEntry('${r.time}',${r.amountMcg})">×</button></td>`;
    tbody.appendChild(tr);
  });
  document.getElementById('histCount').textContent=filtered.length+' entries shown';
}
function deleteEntry(time,amt){
  if(!confirm('Delete this entry?'))return;
  let d=loadData();const i=d.findIndex(e=>e.time===time&&e.amountMcg===amt);
  if(i>-1)d.splice(i,1);saveData(d);renderHistory();renderPkChart();
}
function exportData(){
  const blob=new Blob([JSON.stringify(getData(),null,2)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='smack_tracker_backup.json';a.click();
}
function importJSON(){document.getElementById('importFile').click();}
function handleImportFile(e){
  const file=e.target.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      const inc=JSON.parse(ev.target.result);
      if(!Array.isArray(inc))throw new Error('not an array');
      const ex=loadData();let added=0;
      inc.forEach(r=>{if(!isDup(r,ex)){ex.push(r);added++;}});
      saveData(ex);alert('Imported '+added+' new entries.');renderHistory();renderPkChart();
    }catch(err){alert('Import failed: '+err.message);}
  };
  reader.readAsText(file);e.target.value='';
}

// ─── PK sharktooth chart ──────────────────────────────────────────────────────
// Buprenorphine PK constants (fixed)
// t½ = 37hr  (effective terminal t½, chronic dosing)
// tPeak slider = actual time to peak (tmax). ka is solved numerically from tmax.
//   Moving slider from 1.5→4hr only reshapes the absorption ramp; peak height
//   and steady-state level are unchanged.
// ke = ln(2)/t½    (first-order elimination rate constant)
// Units: mcg-accumulated (dose-equivalent)
// 750 mcg q24h SS peak ≈ 2071 mcg, trough ≈ 1336 mcg (both tPeak-independent)

// Fixed PK params — frozen to literature-accurate values for sublingual buprenorphine.
// t½ 36hr sits mid-range of reported terminal half-lives (~22–44hr for SL bup).
// Tmax 2hr sits within the reported 40min–3.5hr window for SL peak concentration.
const pkParams = {
  tHalf: 36,   // hours
  tPeak: 2,    // hours (time to max concentration)
};

function getPkKe()  { return Math.log(2) / pkParams.tHalf; }

// Solve for ka such that the true tmax of the absorption curve equals pkParams.tPeak.
// tmax = ln(ka/ke)/(ka-ke) — this can't be inverted algebraically, so we bisect.
// This means the slider directly controls when the drug peaks, not a proxy.
function getPkKa()  {
  const ke = getPkKe();
  const tmaxTarget = pkParams.tPeak;
  // tmax is a decreasing function of ka (larger ka = faster absorption = earlier peak)
  // Bisect in [ke + epsilon, large] for ka such that tmax(ka) == tmaxTarget
  let lo = ke + 1e-9, hi = 1000.0;
  for(let i = 0; i < 80; i++){
    const mid = (lo + hi) / 2;
    const tmax = Math.log(mid / ke) / (mid - ke);
    if(tmax > tmaxTarget) lo = mid; else hi = mid;
  }
  return (lo + hi) / 2;
}

// Single-dose concentration at time t hours post-dose — used everywhere
// (dashboard, simulator, sharktooth chart).
//
// Normalized oral 1-cpt model: rises from 0, peaks at exactly doseAmtMcg
// at tmax (~7.2hr), then decays with t½=37hr. So:
//   1600 mcg baseline + 250 mcg dose: the 250 ramps up over ~7hr while
//   the 1600 keeps decaying. Net peak ≈ 1850 minus ~3.5% decay on the 1600
//   (≈1843 mcg). Correct, consistent, no bioavailability distortion.
//
// C(t) = D * (e^(-ke*t) - e^(-ka*t)) / (e^(-ke*tmax) - e^(-ka*tmax))
// tmax = ln(ka/ke)/(ka-ke)
function pkConc(doseAmtMcg, tHours) {
  if(tHours < 0) return 0;
  const ke = getPkKe();
  const ka = getPkKa();
  if(Math.abs(ka - ke) < 1e-9) {
    const tmax = 1 / ke;
    const peakRaw = ke * tmax * Math.exp(-ke * tmax);
    return doseAmtMcg * (ke * tHours * Math.exp(-ke * tHours)) / peakRaw;
  }
  const tmax = Math.log(ka / ke) / (ka - ke);
  const peakRaw = Math.exp(-ke * tmax) - Math.exp(-ka * tmax);
  return doseAmtMcg * (Math.exp(-ke * tHours) - Math.exp(-ka * tHours)) / peakRaw;
}

function updatePkFooter() {
  const ke = getPkKe();
  const ka = getPkKa();
  document.getElementById('pkFooter').textContent =
    'oral 1-cpt model · t½=' + pkParams.tHalf + 'hr · Tmax=' + pkParams.tPeak + 'hr · ke=' + ke.toFixed(4) + '/hr · ka=' + ka.toFixed(4) + '/hr';
}

let pkChart=null, pkRangeKey='7d';
let pkModifierOn=false;          // Modifier variability band toggle
let pkCustomRange=null;          // {start, end} in ms when a custom date range is active

// ═══ PET-calibrated pharmacodynamic pipeline ═══════════════════════════════
// The app converts logged doses into an estimate of μ-opioid RECEPTOR OCCUPANCY,
// because occupancy — not milligrams — is what tracks the biology, and it's what
// makes low-dose tapering legible. Every box runs this one frozen chain:
//
//   (1) dose log → accumulated dose-equivalent (mcg)   [existing 1-cpt model,
//        t½=36h, Tmax=2h]  — this gives the correct time SHAPE.
//   (2) dose-equivalent → plasma concentration (ng/mL) via a power law that
//        captures buprenorphine's well-documented LESS-than-dose-proportional
//        absorption:  C = PD_A * (equiv)^PD_P
//   (3) plasma → occupancy (%) via the published saturable Emax model:
//        occ = EMAX * C / (EC50 + C)
//
// Calibration (all fixed, from direct PET [11C]carfentanil data, Greenwald 2003):
//   measured occupancy 41% @2mg, 80% @16mg, 84% @32mg;
//   peak plasma 0.6, 5.5, 13.5 ng/mL respectively.
//   Emax=91%, EC50=0.67 ng/mL (Nasser 2014 / Indivior pop-PK/PD).
//   PD_A, PD_P are fit so C(equiv) passes through the 2mg & 16mg plasma points.
// Result reproduces PET: 2mg→43%, 16mg→81%, 32mg→87%. Frozen — no user knobs.
const PD_EMAX = 91;        // % maximum occupancy
const PD_EC50 = 0.67;      // ng/mL at half-max
const PD_A    = 6.2905e-5; // ng/mL per (mcg-equiv)^PD_P
const PD_P    = 1.0655;    // less-than-dose-proportional exponent

// Within-person dose-to-dose absorption variability: within-subject CV ≈ 34%
// (Bullingham; used as dose-bioavailability CV in a published SL-bup PBPK model).
// Applied as ±1 SD on the dose-equivalent before the ng/mL + occupancy chain.
const PK_VAR_SD = 0.34;

// Clinical reference occupancies (derived in ACTIVE-USE context — shown for
// orientation only, NOT as pass/fail for a low-dose taperer):
//   ~50% occ ≈ withdrawal-suppression threshold (Greenwald)
//   ~70% occ ≈ treatment-optimal / blockade target
const OCC_WITHDRAWAL = 50;
const OCC_OPTIMAL    = 70;

// Taper-endpoint landmarks (from clinical taper literature, mapped through this
// same model so they stay internally consistent):
//   ~40% occ  ≈ the "2 mg wall" — the widely-cited hardest step of a taper,
//               where 2 mg/day still holds ~40% of receptors and clinicians
//               switch to 0.25–0.5 mg decrements.
//   ~8–15% occ ≈ typical JUMP-OFF ZONE — the 0.25–0.5 mg/day doses people
//               usually discontinue from (often with clinician support / comfort
//               meds), rather than cutting further. The goal is to REACH this
//               zone and stop — not to chase occupancy toward zero.
const OCC_TWO_MG_WALL = 40;
const OCC_JUMP_HI     = 15;   // ~0.5 mg/day
const OCC_JUMP_LO     = 8;    // ~0.25 mg/day

// dose-equivalent (mcg) → plasma concentration (ng/mL)
function equivToNgml(equivMcg){
  if(equivMcg <= 0) return 0;
  return PD_A * Math.pow(equivMcg, PD_P);
}
// plasma concentration (ng/mL) → μOR occupancy (%)
function ngmlToOcc(C){
  if(C <= 0) return 0;
  return PD_EMAX * C / (PD_EC50 + C);
}
// dose-equivalent (mcg) → occupancy (%), the full frozen chain
function equivToOcc(equivMcg){
  return ngmlToOcc(equivToNgml(equivMcg));
}

// ── Inverse of the frozen chain: occupancy (%) → dose-equivalent (mcg) ────────
// occupancy → ng/mL:  occ = EMAX·C/(EC50+C)  ⇒  C = EC50·occ/(EMAX−occ)
// ng/mL → equiv:      C = A·equiv^P          ⇒  equiv = (C/A)^(1/P)
// Used to label the occupancy reference lines with their approximate mcg/mg
// dose-equivalent, so both estimates are always shown together.
function occToNgml(occ){
  if(occ <= 0) return 0;
  if(occ >= PD_EMAX) return Infinity;
  return PD_EC50 * occ / (PD_EMAX - occ);
}
function ngmlToEquiv(C){
  if(C <= 0) return 0;
  return Math.pow(C / PD_A, 1 / PD_P);
}
function occToEquiv(occ){
  return ngmlToEquiv(occToNgml(occ));
}
// Format an occupancy % as its dose-equivalent, respecting the current unit.
// Returns e.g. "~2 mg" or "~750 mcg". Clamps absurd values.
function occToDoseLabel(occ){
  const eq = occToEquiv(occ);
  if(!isFinite(eq) || eq <= 0) return '';
  return '~' + fmtAmt(eq);
}

const PK_RANGES=[
  {key:'72h',  label:'72 hours', days:3},
  {key:'7d',   label:'7 days',   days:7},
  {key:'3wk',  label:'3 weeks',  days:21},
  {key:'6wk',  label:'6 weeks',  days:42},
  {key:'3mo',  label:'3 months', days:91},
  {key:'9mo',  label:'9 months', days:274},
  {key:'1yr',  label:'1 year',   days:365},
  {key:'all',  label:'all time', days:0},
];

function buildRangeBar(){
  const bar=document.getElementById('pkRangeBar');
  bar.innerHTML='';
  const active=k=>!pkCustomRange&&k===pkRangeKey;
  PK_RANGES.forEach(r=>{
    const btn=document.createElement('button');
    btn.className='range-pill'+(active(r.key)?' active':'');
    btn.textContent=r.label;
    btn.onclick=()=>{pkCustomRange=null;syncPkDateInputs();pkRangeKey=r.key;buildRangeBar();renderPkChart();};
    bar.appendChild(btn);
  });
  // dynamic year pills — one per year detected in the data
  const data=loadData();
  if(data.length){
    const years=[...new Set(data.map(r=>new Date(r.time).getFullYear()))].sort();
    // only bother when the data spans more than one calendar year
    if(years.length>1){
      years.forEach(yr=>{
        const btn=document.createElement('button');
        btn.className='range-pill'+(active(String(yr))?' active':'');
        btn.textContent=String(yr);
        btn.dataset.yr=yr;
        btn.onclick=()=>{pkCustomRange=null;syncPkDateInputs();pkRangeKey=String(yr);buildRangeBar();renderPkChart();};
        bar.insertBefore(btn,bar.children[bar.children.length-1]);
      });
    }
  }
}

function getPkWindow(){
  if(pkCustomRange) return {start:pkCustomRange.start, end:pkCustomRange.end};
  const range=PK_RANGES.find(r=>r.key===pkRangeKey)||(()=>{
    // year key
    const yr=parseInt(pkRangeKey);
    if(!isNaN(yr))return{year:yr};
    return{days:30};
  })();
  const now=nowMs();
  if(range.year){
    return{start:new Date(range.year,0,1).getTime(), end:new Date(range.year+1,0,1).getTime()};
  }
  if(range.days===0){
    const data=loadData();
    if(!data.length)return{start:now-30*86400000,end:now+86400000};
    const earliest=Math.min(...data.map(r=>new Date(r.time).getTime()));
    return{start:earliest-3600000,end:now+86400000};
  }
  return{start:now-range.days*86400000,end:now+3600000};
}

function simulatePkSeries(data, windowStart, windowEnd){
  const sorted=[...data].sort((a,b)=>new Date(a.time)-new Date(b.time));
  if(!sorted.length)return{times:[],levels:[]};

  // Include all doses up to windowEnd that could still contribute at windowStart
  // Cutoff: doses more than 7 half-lives before windowStart contribute < 1% — ignore them
  const ignoreCutoffMs = windowStart - 7 * pkParams.tHalf * 3600000;
  const doses = sorted.filter(r => {
    const ms = new Date(r.time).getTime();
    return ms >= ignoreCutoffMs && ms <= windowEnd;
  });

  // Adaptive resolution
  const windowHours = (windowEnd - windowStart) / 3600000;
  let dtHours;
  if      (windowHours <= 72)   dtHours = 0.1;
  else if (windowHours <= 720)  dtHours = 0.5;
  else if (windowHours <= 4380) dtHours = 2;
  else                           dtHours = 6;

  const times=[], levels=[];
  const dtMs = dtHours * 3600000;

  for(let ms = windowStart; ms <= windowEnd; ms += dtMs){
    let lv = 0;
    for(const dose of doses){
      const doseMs = new Date(dose.time).getTime();
      if(doseMs > ms) break; // doses are sorted ascending
      const tH = (ms - doseMs) / 3600000;
      lv += pkConc(dose.amountMcg, tH);
    }
    times.push(ms);
    levels.push(parseFloat(lv.toFixed(1)));
  }
  return{times, levels};
}

// ── Sustained-reduction detector ───────────────────────────────────────────────
// Samples occupancy once per day across [start,end], then finds the longest
// stretch over which occupancy is trending DOWN (a taper). If such a stretch
// lasts at least 2 weeks, returns its total drop, duration, and average
// per-week reduction so the dashboard can surface it. Small day-to-day upticks
// (dosing noise) inside an overall downtrend don't break the run.
const REDUCTION_MIN_DAYS = 14;      // must be sustained ≥ 2 weeks
function detectSustainedReduction(data, start, end){
  const DAY=86400000;
  // Daily occupancy samples (trough-ish: sample at same clock time each day).
  const samples=[];
  for(let ms=start; ms<=end; ms+=DAY){
    let lv=0;
    for(const d of data){
      const dm=new Date(d.time).getTime();
      if(dm>ms) continue;
      const tH=(ms-dm)/3600000;
      if(tH > 12*pkParams.tHalf) continue;
      lv+=pkConc(d.amountMcg, tH);
    }
    samples.push({ms, occ:equivToOcc(lv)});
  }
  if(samples.length < REDUCTION_MIN_DAYS) return null;

  // Grow the longest non-increasing run (tolerate tiny bumps up to 1.5 pts).
  const TOL=1.5;
  let best=null, runStart=0, peakIdx=0;
  for(let i=1;i<samples.length;i++){
    // If occupancy rises meaningfully above the running peak, the downtrend broke.
    if(samples[i].occ > samples[peakIdx].occ + TOL){
      runStart=i; peakIdx=i; continue;
    }
    if(samples[i].occ < samples[peakIdx].occ) peakIdx=i; // new low extends run
    const drop=samples[runStart].occ - samples[i].occ;
    const days=(samples[i].ms - samples[runStart].ms)/DAY;
    if(drop>0.5 && days>=REDUCTION_MIN_DAYS){
      if(!best || days>best.days || (Math.abs(days-best.days)<0.5 && drop>best.drop)){
        best={startMs:samples[runStart].ms, endMs:samples[i].ms, days,
              startOcc:samples[runStart].occ, endOcc:samples[i].occ, drop};
      }
    }
  }
  if(!best) return null;
  best.perWeek = best.drop / (best.days/7);
  return best;
}
function renderReductionBox(data, start, end){
  const el=document.getElementById('pkReduction');
  if(!el) return;
  const r=detectSustainedReduction(data, start, end);
  if(!r){ el.style.display='none'; return; }
  const fmtD=ms=>{const d=new Date(ms);return (d.getMonth()+1)+'/'+d.getDate()+'/'+String(d.getFullYear()).slice(2);};
  const startDose=occToDoseLabel(r.startOcc), endDose=occToDoseLabel(r.endOcc);
  el.innerHTML =
    '<b>sustained reduction detected</b> · '+Math.round(r.days)+' days ('+fmtD(r.startMs)+' → '+fmtD(r.endMs)+')<br>'+
    'average reduction: <b>'+r.perWeek.toFixed(1)+' pts / week</b> '+
    '('+r.drop.toFixed(1)+' pts total, from '+Math.round(r.startOcc)+'% '+(startDose?startDose+' ':'')+
    'to '+Math.round(r.endOcc)+'% '+(endDose?endDose:'')+')';
  el.style.display='block';
}

function renderPkChart(){
  const data=loadData();
  const {start,end}=getPkWindow();
  const {times,levels}=simulatePkSeries(data,start,end);
  const c=chartColors();
  const windowHours=(end-start)/3600000;

  function fmtLabel(ms){
    const d=new Date(ms);
    if(windowHours<=72)
      return (d.getMonth()+1)+'/'+d.getDate()+' '+d.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
    if(windowHours<=720)
      return (d.getMonth()+1)+'/'+d.getDate();
    return (d.getMonth()+1)+'/'+d.getDate()+'/'+String(d.getFullYear()).slice(2);
  }

  // Decide tick density
  const maxTicks=windowHours<=72?12:windowHours<=720?14:12;
  const step=Math.ceil(times.length/maxTicks);
  const tickLabels=times.map((ms,i)=>i%step===0?fmtLabel(ms):'');

  // ── Convert dose-equivalent → μOR occupancy (%) via the frozen chain ─────
  // OFF: single occupancy line. ON: ±1 SD absorption band applied on the
  // dose-equivalent, each edge pushed through equivToOcc() (so the band is
  // narrow where the curve saturates and wide on the steep low-dose part —
  // which is the honest behavior).
  const occOf = eq => parseFloat(equivToOcc(eq).toFixed(1));
  let datasets;
  if(pkModifierOn){
    const center = levels.map(occOf);
    const upper  = levels.map(v=>occOf(v*(1+PK_VAR_SD)));
    const lower  = levels.map(v=>occOf(v*(1-PK_VAR_SD)));
    datasets=[
      { label:'+1 SD absorption', data:upper, borderColor:c.line, backgroundColor:'transparent',
        borderWidth:1, borderDash:[3,3], pointRadius:0, fill:false, tension:0 },
      { label:'occupancy (est.)', data:center, borderColor:c.line, backgroundColor:c.fill,
        borderWidth:1.5, pointRadius:0, fill:'+1', tension:0 },
      { label:'−1 SD absorption', data:lower, borderColor:c.line, backgroundColor:'transparent',
        borderWidth:1, borderDash:[3,3], pointRadius:0, fill:false, tension:0 }
    ];
  } else {
    datasets=[{
      label:'occupancy (est.)', data:levels.map(occOf), borderColor:c.line, backgroundColor:c.fill,
      borderWidth:1.5, pointRadius:0, fill:true, tension:0
    }];
  }

  if(pkChart){pkChart.destroy();pkChart=null;}

  // Occupancy axis is a fixed 0–100%. We crop the TOP if the whole trace sits
  // low (the low-dose taper case), so the steep region fills the panel.
  const plotted = datasets.flatMap(ds=>ds.data).filter(v=>typeof v==='number');
  let yMax = 100;
  if(plotted.length){
    const dataMax = Math.max(...plotted);
    if(dataMax < 55){ yMax = Math.min(100, Math.ceil((dataMax+8)/10)*10); }  // give the low-dose curve room
  }

  pkChart=new Chart(document.getElementById('pkChart'),{
    type:'line',
    data:{ labels:tickLabels, datasets },
    options:{
      responsive:true,maintainAspectRatio:false,animation:false,
      interaction:{mode:'index',intersect:false},
      plugins:{legend:{display:pkModifierOn,labels:{color:c.tick,font:{size:10,family:'Courier New'},boxWidth:14}},tooltip:{
        mode:'index',intersect:false,
        callbacks:{
          title:ctx=>{const ms=times[ctx[0].dataIndex];return new Date(ms).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});},
          label:ctx=>{
            const eq=levels[ctx.dataIndex]||0;
            const ng=equivToNgml(eq);
            return ctx.dataset.label+': '+Math.round(ctx.parsed.y)+'%  (~'+ng.toFixed(2)+' ng/mL)';
          }
        }
      }},
      scales:{
        x:{type:'category',ticks:{color:c.tick,font:{size:9,family:'Courier New'},maxRotation:45,autoSkip:true,maxTicksLimit:14},grid:{color:c.grid}},
        y:{min:0,max:yMax,ticks:{color:c.tick,font:{size:10,family:'Courier New'},callback:v=>v+'%'},grid:{color:c.grid},title:{display:true,text:'est. μ-opioid receptor occupancy',color:c.tick,font:{size:9,family:'Courier New'}}}
      }
    },
    plugins:[{id:'occRefs', afterDraw(ch){
      const ctx=ch.ctx, yA=ch.scales.y, xA=ch.scales.x;
      // Minimum vertical gap (px) between two label baselines before we treat
      // them as colliding. The label font is 9px, so ~13px keeps them legible.
      const LABEL_MIN_GAP = 14;

      // Every reference line we might draw, top→bottom in occupancy space.
      // dosed:true means we suffix the approximate mcg/mg equivalent so the
      // occupancy % and the dose estimate are always shown together.
      const refs=[
        {occ:OCC_OPTIMAL,    color:(c.dash||c.tick), text:'active-use optimal ~70%',       dash:[5,4], dosed:true},
        {occ:OCC_WITHDRAWAL, color:(c.dash||c.tick), text:'active-use floor ~50%',         dash:[5,4], dosed:true},
        {occ:OCC_TWO_MG_WALL,color:c.tick,           text:'the 2 mg wall — hardest step (~40%)', dash:[2,3], dosed:false}
      ].filter(r=>r.occ<=yA.max && r.occ>=yA.min);

      // Draw all the reference LINES first (lines never crumple, only labels do).
      refs.forEach(r=>{
        const y=yA.getPixelForValue(r.occ);
        ctx.save();
        ctx.strokeStyle=r.color; ctx.lineWidth=1; ctx.setLineDash(r.dash||[5,4]);
        ctx.beginPath(); ctx.moveTo(xA.left,y); ctx.lineTo(xA.right,y); ctx.stroke();
        ctx.restore();
      });

      // ── Steep-zone band (roughly 15–45% occ) ────────────────────────────────
      const yTop=yA.getPixelForValue(Math.min(yA.max,45));
      const yBot=yA.getPixelForValue(Math.max(yA.min,15));
      let steepBandVisible=false;
      if(yBot>yTop){
        steepBandVisible=true;
        ctx.save();
        ctx.fillStyle=c.fill;
        ctx.globalAlpha=0.4;
        ctx.fillRect(xA.left,yTop,xA.right-xA.left,yBot-yTop);
        ctx.globalAlpha=1;
        ctx.restore();
      }

      // ── Jump-off zone band (~8–15% occ) ─────────────────────────────────────
      let jumpBot=null;
      if(yA.min <= OCC_JUMP_HI){
        const jTop=yA.getPixelForValue(Math.min(yA.max,OCC_JUMP_HI));
        const jBot=yA.getPixelForValue(Math.max(yA.min,OCC_JUMP_LO));
        if(jBot>jTop){
          jumpBot=jBot;
          ctx.save();
          ctx.fillStyle=c.line;
          ctx.globalAlpha=0.16;
          ctx.fillRect(xA.left,jTop,xA.right-xA.left,jBot-jTop);
          ctx.globalAlpha=1;
          ctx.restore();
        }
      }

      // ── Decide whether labels would crumple ─────────────────────────────────
      // Collect every label we intend to render with its baseline y, then check
      // for overlaps. If the y-axis is compressed (going from 3mo → 6wk → 3wk),
      // the steep-zone label, the 2mg-wall label and the active-use lines pile
      // onto each other. When that happens we suppress the individual labels and
      // draw ONE consolidated message instead.
      const candidates=[];
      if(steepBandVisible) candidates.push({y:yTop-3});
      refs.forEach(r=>candidates.push({y:yA.getPixelForValue(r.occ)-3}));
      if(jumpBot!==null) candidates.push({y:jumpBot+11});
      candidates.sort((a,b)=>a.y-b.y);
      let crumpled=false;
      for(let i=1;i<candidates.length;i++){
        if(candidates[i].y - candidates[i-1].y < LABEL_MIN_GAP){ crumpled=true; break; }
      }

      ctx.save();
      if(crumpled){
        // Consolidated message: we're in the hardest segment of the taper.
        ctx.fillStyle=c.tick; ctx.font='bold 9px Courier New';
        const cx=xA.left+4;
        let cy=yA.top+12;
        const lines=[
          'hardest segment: under 2 mg, above the typical jump-off zone',
          '15%–40% occ — small changes here are nonlinear, and',
          'bioavailability makes real-world dosing variable'
        ];
        lines.forEach(t=>{ ctx.fillText(t, cx, cy); cy+=11; });
      } else {
        // Enough room — label each feature individually, with dose equivalents.
        ctx.font='9px Courier New';
        if(steepBandVisible){
          ctx.fillStyle=c.tick;
          ctx.fillText('steep zone — small dose changes move occupancy most', xA.left+4, yTop-3);
        }
        refs.forEach(r=>{
          const y=yA.getPixelForValue(r.occ);
          ctx.fillStyle=r.color;
          const dl=r.dosed?occToDoseLabel(r.occ):'';
          ctx.fillText(dl?(r.text+' · '+dl):r.text, xA.left+4, y-3);
        });
        if(jumpBot!==null){
          ctx.fillStyle=c.line; ctx.font='bold 9px Courier New';
          ctx.fillText('typical jump-off zone (~0.25–0.5 mg) — most people stop here', xA.left+4, jumpBot+11);
        }
      }
      ctx.restore();
    }}]
  });

  // Surface the average reduction if a ≥2-week sustained taper is present.
  renderReductionBox(data, start, end);
}

// ── Modifier toggle + custom date range ───────────────────────────────────────
function onPkModToggle(){
  pkModifierOn=document.getElementById('pkModToggle').checked;
  rebuildPkChart();
  try{ updateNowBlock(); }catch(e){}
}
function syncPkDateInputs(){
  const s=document.getElementById('pkDateStart'), e=document.getElementById('pkDateEnd');
  if(!pkCustomRange){ if(s)s.value=''; if(e)e.value=''; document.getElementById('pkDateCount').textContent=''; }
}
function onPkDateRange(){
  const sv=document.getElementById('pkDateStart').value;
  const ev=document.getElementById('pkDateEnd').value;
  const cnt=document.getElementById('pkDateCount');
  if(!sv||!ev){ pkCustomRange=null; cnt.textContent=''; buildRangeBar(); renderPkChart(); return; }
  let start=new Date(sv+'T00:00').getTime();
  let end=new Date(ev+'T23:59').getTime();
  if(end<start){ const t=start; start=end-86340000; end=t+86340000; } // swap-safe
  pkCustomRange={start,end};
  const days=Math.max(1, Math.round((end-start)/86400000));
  cnt.textContent='= '+days+' day'+(days===1?'':'s');
  buildRangeBar();
  renderPkChart();
}
function clearPkDateRange(){
  pkCustomRange=null;
  document.getElementById('pkDateStart').value='';
  document.getElementById('pkDateEnd').value='';
  document.getElementById('pkDateCount').textContent='';
