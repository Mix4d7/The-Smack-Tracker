const CONSENT_KEY = 'st_consent_neveragain';
function refreshGate(){
  const box = document.getElementById('gateBox'); if(!box) return;
  let acked = false;
  try{ acked = sessionStorage.getItem('st_session_acked')==='1' || localStorage.getItem(CONSENT_KEY)==='1'; }catch(e){}
