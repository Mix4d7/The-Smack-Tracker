function updateClock(){
  const n=new Date();
  const d=n.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});
  const t=n.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  document.getElementById('clockDisplay').innerHTML=d+'<br>'+t;
  try{ updateNowBlock(); }catch(e){}
}
setInterval(updateClock,1000); updateClock();
function setLogTimeNow(){
  const n=new Date(),pad=x=>String(x).padStart(2,'0');
  document.getElementById('logTime').value=n.getFullYear()+'-'+pad(n.getMonth()+1)+'-'+pad(n.getDate())+'T'+pad(n.getHours())+':'+pad(n.getMinutes());
}
