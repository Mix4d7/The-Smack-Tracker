let curLang = localStorage.getItem('st_lang') || 'en';
function t(key){ return (LANG[curLang] && LANG[curLang][key]) || LANG.en[key] || key; }
function langDef(code){ return LANGS.find(l=>l.code===code) || LANGS[0]; }
function applyLang(){
  const def = langDef(curLang);
  document.documentElement.lang = curLang;
  document.documentElement.dir = def.rtl ? 'rtl' : 'ltr';
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    el.textContent = t(el.getAttribute('data-i18n'));
  });
  const enBtn = document.getElementById('langEnBtn');
  if(enBtn) enBtn.classList.toggle('active', curLang==='en');
  document.querySelectorAll('#langMenu .lang-opt').forEach(b=>{
    b.classList.toggle('active', b.dataset.code===curLang);
  });
}
function buildLangMenu(){
  const menu = document.getElementById('langMenu'); if(!menu) return;
  menu.innerHTML = '';
  LANGS.forEach(l=>{
    const b = document.createElement('button');
    b.className = 'lang-opt' + (l.code===curLang ? ' active' : '');
    b.dataset.code = l.code;
    const translated = !!LANG[l.code];
    b.innerHTML = l.native + (translated ? '' : ' <small>(EN)</small>');
    b.onclick = ()=> setLang(l.code);
    menu.appendChild(b);
  });
}
function toggleLangMenu(){ document.getElementById('langMenu').classList.toggle('open'); }
function closeLangMenu(){ const m=document.getElementById('langMenu'); if(m) m.classList.remove('open'); }
function setLang(code){
  curLang = code;
  localStorage.setItem('st_lang', code);
  closeLangMenu();
  applyLang();
}
document.addEventListener('click', e=>{
  if(!e.target.closest('.lang-wrap')) closeLangMenu();
});

