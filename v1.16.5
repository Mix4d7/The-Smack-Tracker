// ─── Time Machine ─────────────────────────────────────────────────────────────
// TM_OFFSET_MS is added to real time everywhere the app asks for "now". When
// zero the app runs in the real present. Positive values push the reference
// clock into the future (up to 14 days) so mg/mcg equivalents and receptor
// occupancy can be seen decaying forward from the last logged dose.
let TM_OFFSET_MS = 0;
const TM_MAX_MS = 14 * 86400000;   // hard ceiling: 14 days forward
function nowMs(){ return Date.now() + TM_OFFSET_MS; }
function tmActive(){ return TM_OFFSET_MS > 0; }

function tmToggleBox(){
  const box = document.getElementById('tmBox');
  if(!box) return;
  box.classList.toggle('open');
  if(box.classList.contains('open')) tmSyncSliders();
}
function tmClampOffset(ms){ return Math.max(0, Math.min(TM_MAX_MS, ms)); }

// Read the two sliders (days + hours), combine, clamp, apply.
function tmApplyFromSliders(){
  const days  = parseInt(document.getElementById('tmDays').value)||0;
  const hours = parseInt(document.getElementById('tmHours').value)||0;
  TM_OFFSET_MS = tmClampOffset(days*86400000 + hours*3600000);
  tmSyncLabels();
  tmRefreshAll();
}
function tmSyncLabels(){
  const days  = parseInt(document.getElementById('tmDays').value)||0;
  const hours = parseInt(document.getElementById('tmHours').value)||0;
  document.getElementById('tmDaysVal').textContent  = days + (days===1?' day':' days');
  document.getElementById('tmHoursVal').textContent = hours + (hours===1?' hr':' hrs');
  const target = new Date(Date.now() + tmClampOffset(days*86400000 + hours*3600000));
  document.getElementById('tmTargetLabel').textContent =
    target.toLocaleString('en-US',{weekday:'short',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
}
// If the box is opened while active, reflect current offset back onto sliders.
function tmSyncSliders(){
  const days  = Math.min(14, Math.floor(TM_OFFSET_MS/86400000));
  const hours = Math.min(36, Math.round((TM_OFFSET_MS - days*86400000)/3600000));
  document.getElementById('tmDays').value  = days;
  document.getElementById('tmHours').value = hours;
  tmSyncLabels();
}
function tmReturnToPresent(){
  TM_OFFSET_MS = 0;
  document.getElementById('tmDays').value = 0;
  document.getElementById('tmHours').value = 0;
  tmSyncLabels();
  const box = document.getElementById('tmBox'); if(box) box.classList.remove('open');
  tmRefreshAll();
}
// Update the button label + banner + re-render everything time-dependent.
function tmRefreshAll(){
  const btn = document.getElementById('tmBtn');
  const banner = document.getElementById('tmBanner');
  const block = document.getElementById('nowBlock');
  if(tmActive()){
    if(btn) btn.textContent = 'Return to Present';
    if(btn) btn.classList.add('tm-on');
    if(block) block.classList.add('tm-projected');
    if(banner){
      const target = new Date(nowMs());
      banner.textContent = '⏩ Time Machine — projected to ' +
        target.toLocaleString('en-US',{weekday:'short',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) +
        ' (nothing logged; showing forward decay)';
      banner.style.display = 'block';
    }
  } else {
    if(btn) btn.textContent = 'Time Machine';
    if(btn) btn.classList.remove('tm-on');
    if(block) block.classList.remove('tm-projected');
    if(banner) banner.style.display = 'none';
  }
  try{ updateNowBlock(); }catch(e){}
  try{ if(typeof renderPkChart==='function' && document.getElementById('panel-history').classList.contains('active')) renderPkChart(); }catch(e){}
}
// Single click handler for the button: opens box, or returns to present.
function tmButtonClick(){
  if(tmActive()){ tmReturnToPresent(); }
  else { tmToggleBox(); }
}

